<Project>
  <PropertyGroup>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!--
    Read full version from version.txt at evaluation time (not in a target!)
    Format: "Major.Minor.Patch" e.g. "0.1.64"
  -->
  <PropertyGroup>
    <EChatVersionFile>$(MSBuildProjectDirectory)\version.txt</EChatVersionFile>
    <EChatVersionRaw Condition="Exists('$(EChatVersionFile)')">$([System.IO.File]::ReadAllText('$(EChatVersionFile)').Trim())</EChatVersionRaw>
    <EChatVersion Condition="'$(EChatVersionRaw)' != ''">$(EChatVersionRaw)</EChatVersion>
    <EChatVersion Condition="'$(EChatVersion)' == ''">0.1.1</EChatVersion>

    <EChatMajor>$([System.Version]::Parse('$(EChatVersion)').Major)</EChatMajor>
    <EChatMinor>$([System.Version]::Parse('$(EChatVersion)').Minor)</EChatMinor>
    <EChatPatch>$([System.Version]::Parse('$(EChatVersion)').Build)</EChatPatch>

    <Version>$(EChatVersion)</Version>
    <PackageVersion>$(EChatVersion)</PackageVersion>
    <AssemblyVersion>$(EChatMajor).$(EChatMinor).$(EChatPatch).0</AssemblyVersion>
    <FileVersion>$(EChatMajor).$(EChatMinor).$(EChatPatch).0</FileVersion>
    <EChatBuildDate>$([System.DateTime]::UtcNow.ToString("yyyy.MM.dd"))</EChatBuildDate>
    <InformationalVersion>$(EChatVersion)+$(EChatBuildDate)</InformationalVersion>
  </PropertyGroup>

  <!--
    Auto-increment version.txt after successful build.
    A lock file next to version.txt prevents double-increment when MSBuild builds
    multiple projects (or multiple TFMs) in the same process / same second.
    The lock file stores the already-incremented version; if it matches what we
    would write, we skip the write.
  -->
  <PropertyGroup>
    <EChatVersionLockFile>$(MSBuildProjectDirectory)\version.lock</EChatVersionLockFile>
    <EChatNextPatch>$([MSBuild]::Add('$(EChatPatch)', '1'))</EChatNextPatch>
    <EChatNextVersion>$(EChatMajor).$(EChatMinor).$(EChatNextPatch)</EChatNextVersion>
    <EChatLockContent Condition="Exists('$(EChatVersionLockFile)')">$([System.IO.File]::ReadAllText('$(EChatVersionLockFile)').Trim())</EChatLockContent>
    <EChatAlreadyIncremented Condition="'$(EChatLockContent)' == '$(EChatNextVersion)'">true</EChatAlreadyIncremented>
  </PropertyGroup>

  <Target Name="IncrementEChatVersion" AfterTargets="Build"
          Condition="'$(EChatAlreadyIncremented)' != 'true'">
    <WriteLinesToFile File="$(EChatVersionFile)" Lines="$(EChatNextVersion)" Overwrite="true" />
    <WriteLinesToFile File="$(EChatVersionLockFile)" Lines="$(EChatNextVersion)" Overwrite="true" />
    <Message Text="$(MSBuildProjectName): version $(EChatVersion) -> $(EChatNextVersion)" Importance="high" />
  </Target>
</Project>