<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-android;net10.0-windows10.0.19041.0</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('windows'))">net10.0-android;net10.0-windows10.0.19041.0</TargetFrameworks>
		<!-- Release: no PDB, only ru+en managed satellite DLLs -->
		<!-- NOTE: PublishSingleFile does NOT work for MAUI Blazor Hybrid — WinUI3 native DLLs cannot be bundled -->
		<DebugType Condition="'$(Configuration)'=='Release'">none</DebugType>
		<DebugSymbols Condition="'$(Configuration)'=='Release'">false</DebugSymbols>
		<AndroidIncludeDebugSymbols Condition="'$(Configuration)'=='Debug'">true</AndroidIncludeDebugSymbols>
		<AndroidFastDeployment>false</AndroidFastDeployment>
		<EmbedAssembliesIntoApk Condition="'$(Configuration)'=='Release'">true</EmbedAssembliesIntoApk>
		<!-- Limits managed .NET satellite language DLLs (NuGet packages) to en+ru only -->
		<SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net10.0-ios</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>EChat.Maui</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<EnableDefaultCssItems>false</EnableDefaultCssItems>
		<Nullable>enable</Nullable>
		<NoWarn>CS8600;CS8601;CS8602;CS8603;CS8604;CS0168;CS0219;CA1416;CA1422</NoWarn>


		<!-- Display name -->
		<ApplicationTitle>EChat</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.echat.app</ApplicationId>

		<!-- Versions — read from version.txt so publish.bat increments are reflected in the APK/exe -->
		<_VerRaw>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)version.txt').Trim())</_VerRaw>
		<ApplicationDisplayVersion>$(_VerRaw)</ApplicationDisplayVersion>
		<!-- Android versionCode: last numeric segment (patch), e.g. "0.1.134" → 134 -->
		<ApplicationVersion>$([System.Text.RegularExpressions.Regex]::Match('$(_VerRaw)', '(\d+)$').Value)</ApplicationVersion>
		<Version>$(_VerRaw)</Version>
		<AssemblyVersion>$(_VerRaw)</AssemblyVersion>
		<InformationalVersion>$(_VerRaw)+$([System.DateTime]::UtcNow.ToString("yyyyMMddHHmm"))</InformationalVersion>

		<WindowsPackageType>MSIX</WindowsPackageType>

		<!-- Android -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>

		<!-- Windows -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

		<!-- iOS -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<GenerateAppInstallerFile>False</GenerateAppInstallerFile>
		<AppxPackageSigningEnabled>False</AppxPackageSigningEnabled>
		<AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
		<AppxAutoIncrementPackageRevision>True</AppxAutoIncrementPackageRevision>
		<AppxSymbolPackageEnabled>False</AppxSymbolPackageEnabled>
		<GenerateTestArtifacts>True</GenerateTestArtifacts>
		<HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
	</PropertyGroup>

	<!-- Track version.txt so MSBuild incremental build detects version bumps even without .cs changes -->
	<ItemGroup>
		<UpToDateCheckInput Include="$(MSBuildThisFileDirectory)version.txt" />
	</ItemGroup>

	<ItemGroup>
		<!-- App Icon -->
		<!-- Android adaptive icon: ForegroundFile = foreground layer, Color = background layer -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#5b8fd9" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\EChat.Core\EChat.Core.csproj" />
		<ProjectReference Include="..\EChat.UI\EChat.UI.csproj" />
	</ItemGroup>

	<!-- Post-publish cleanup for Release Windows builds -->
	<Target Name="CleanupPublishOutput" AfterTargets="Publish" Condition="'$(Configuration)'=='Release' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)'))=='windows'">

		<!-- Remove all language folders except en-US and ru-RU (Windows App SDK .mui files) -->
		<ItemGroup>
			<_LangDirsAll Include="$([System.IO.Directory]::GetDirectories('$(PublishDir)', '*-*', System.IO.SearchOption.TopDirectoryOnly))" />
			<_LangDirsToDelete Include="@(_LangDirsAll)" Condition="!$([System.String]::Copy('%(Filename)').Equals('en-US')) and !$([System.String]::Copy('%(Filename)').Equals('ru-RU')) and !$([System.String]::Copy('%(Filename)').Equals('ru'))" />
		</ItemGroup>
		<RemoveDir Directories="@(_LangDirsToDelete)" ContinueOnError="true" />

		<!-- Remove tile/store icon PNGs — not needed for unpackaged desktop app -->
		<ItemGroup>
			<_TileIcons Include="$(PublishDir)appiconLargeTile.*.png" />
			<_TileIcons Include="$(PublishDir)appiconMediumTile.*.png" />
			<_TileIcons Include="$(PublishDir)appiconSmallTile.*.png" />
			<_TileIcons Include="$(PublishDir)appiconWideTile.*.png" />
			<_TileIcons Include="$(PublishDir)appiconStoreLogo.*.png" />
		</ItemGroup>
		<Delete Files="@(_TileIcons)" ContinueOnError="true" />

		<!-- Remove junk files not needed at runtime -->
		<ItemGroup>
			<_JunkFiles Include="$(PublishDir)AboutAssets.txt" />
			<_JunkFiles Include="$(PublishDir)workloads.json" />
			<_JunkFiles Include="$(PublishDir)workloads.*.json" />
			<_JunkFiles Include="$(PublishDir)WindowsAppRuntime.png" />
		</ItemGroup>
		<Delete Files="@(_JunkFiles)" ContinueOnError="true" />

		<!-- Remove NpuDetect folder (AI/NPU detection, not needed) -->
		<ItemGroup>
			<_JunkDirs Include="$(PublishDir)NpuDetect" />
		</ItemGroup>
		<RemoveDir Directories="@(_JunkDirs)" ContinueOnError="true" />

		<Message Text="Publish cleanup done." Importance="high" />
	</Target>

</Project>