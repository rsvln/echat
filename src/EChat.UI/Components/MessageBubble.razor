@using EChat.Core.Models
@using static EChat.Core.Models.MessageStatus
@using EChat.UI.Services
@using static EChat.Core.ServiceCollectionExtensions
@inject IJSRuntime JS
@inject IPlatformService PlatformService
@inject DatabasePathInfo DbPathInfo

<div class="message-bubble-wrap @(IsOwn ? "own" : "other") @(IsSelected ? "mob-msg-selected" : "")"
     id="msg-@Message.MessageId"
     style="position:relative;display:flex;flex-direction:column;align-items:@(IsOwn ? "flex-end" : "flex-start");margin-bottom:2px;"
     @oncontextmenu="ShowContextMenu"
     @oncontextmenu:preventDefault="true">

    @* ── Main bubble ─────────────────────────────────────────────────── *@
    <div class="message-bubble @(IsOwn ? "own" : "other")">
        @if (!IsOwn)
        {
            <div class="message-sender" style="@(SenderColor != null ? $"color:{SenderColor}" : "")">@(SenderDisplayName ?? Message.Sender)</div>
        }

        @* ── Quoted / replied-to message (inside bubble, like Telegram) ── *@
        @if (QuotedMessage != null)
        {
            <div style="display:flex;flex-direction:row;align-items:stretch;
                        border-radius:2px;margin-bottom:6px;cursor:pointer;overflow:hidden;
                        background:@(IsOwn ? "rgba(0,0,0,0.08)" : "rgba(91,166,66,0.12)");"
                 @onclick="@(() => OnScrollToQuoted.InvokeAsync(QuotedMessage.MessageId))"
                 @onclick:stopPropagation="true">
                <div style="width:3px;flex-shrink:0;background:#5BA642;border-radius:3px 0 0 3px;"></div>
                <div style="padding:5px 8px;overflow:hidden;min-width:0;">
                    <div style="font-size:12px;font-weight:700;color:#5BA642;
                                white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:1px;">
                        @(QuotedSenderName ?? QuotedMessage.Sender.Split('@')[0])
                    </div>
                    <div style="font-size:12px;opacity:0.7;white-space:nowrap;
                                overflow:hidden;text-overflow:ellipsis;">
                        @(QuotedMessage.Content.Length > 100 ? QuotedMessage.Content[..100] + "…" : QuotedMessage.Content)
                    </div>
                </div>
            </div>
        }

        <div class="message-content" style="white-space:pre-wrap;word-break:break-word;">@Message.Content</div>

        @* ── Attachments ───────────────────────────────────────────────── *@
        @if (Attachments != null && Attachments.Count > 0)
        {
            @foreach (var att in Attachments)
            {
                @if (att.IsImage)
                {
                    <div class="message-attachment">
                        <img class="message-attachment-img"
                             src="@GetAttachmentUrl(att)"
                             alt="@att.FileName"
                             @onclick="@(() => OpenImage(att))" />
                        @if (!string.IsNullOrEmpty(att.Caption))
                        {
                            <div class="message-attachment-caption">@att.Caption</div>
                        }
                    </div>
                }
                else
                {
                    <div class="message-attachment">
                        <div class="message-attachment-file" @onclick="@(() => OnAttachmentClick(att))">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                            <span>@att.FileName</span>
                            <span style="color:var(--text-muted);font-size:11px;">(@FormatSize(att.Size))</span>
                        </div>
                        @if (!string.IsNullOrEmpty(att.Caption))
                        {
                            <div class="message-attachment-caption">@att.Caption</div>
                        }
                    </div>
                }
            }
        }

        <div class="message-footer">
            @* Reactions on the left, same row as timestamp *@
            <div class="message-reactions-inline">
                @if (Reactions != null && Reactions.Count > 0)
                {
                    @foreach (var grp in Reactions.GroupBy(r => r.Emoji))
                    {
                        <button class="reaction-badge @(grp.Any(r => r.Sender == UserEmail) ? "active" : "")"
                                @onclick="@(() => OnReact.InvokeAsync((grp.Key, Message)))"
                                @onclick:stopPropagation="true">
                            @grp.Key <span class="reaction-count">@grp.Count()</span>
                        </button>
                    }
                }
            </div>
            @* Time + status on the right *@
            <div style="display:flex;align-items:center;gap:5px;flex-shrink:0;">
                @if (Message.IsEdited)
                {
                    <span style="font-size:10px;color:#999;">edited</span>
                }
                <span class="message-time">@FormatTime(Message.DisplayTimestamp)</span>
                @if (Message.ClockSkewDetected)
                {
                    <span title="Clock skew detected">⏰</span>
                }
                @if (Message.Encrypted)
                {
                    <span>🔒</span>
                }
                @if (IsOwn)
                {
                    @switch (Message.Status)
                    {
                        case MessageStatus.Sending:
                            <span title="Sending…" style="font-size:13px;opacity:0.5;line-height:1;">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                                    <circle cx="12" cy="12" r="9"/>
                                    <polyline points="12 7 12 12 15 14"/>
                                </svg>
                            </span>
                            break;
                        case MessageStatus.Sent:
                            <span title="Sent" style="font-size:13px;opacity:0.55;line-height:1;">
                                <svg width="15" height="11" viewBox="0 0 15 11" fill="none"
                                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="1.5 5.5 5.5 9.5 13.5 1.5"/>
                                </svg>
                            </span>
                            break;
                        case MessageStatus.Read:
                            <span title="Read" style="font-size:13px;color:#4FC3F7;line-height:1;">
                                <svg width="19" height="11" viewBox="0 0 19 11" fill="none"
                                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="1.5 5.5 5.5 9.5 13.5 1.5"/>
                                    <polyline points="6 5.5 10 9.5 18 1.5"/>
                                </svg>
                            </span>
                            break;
                    }
                }
            </div>
        </div>
    </div>
</div>

@* ── Fullscreen image viewer ─────────────────────────────────────── *@
@if (_lightboxUrl != null)
{
    <div style="position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.92);display:flex;align-items:center;justify-content:center;overflow:hidden;touch-action:none;"
         @onclick="CloseLightboxSafe">
        <img id="echat-lightbox-img"
             src="@_lightboxUrl"
             style="max-width:95vw;max-height:92vh;object-fit:contain;border-radius:4px;box-shadow:0 8px 40px rgba(0,0,0,0.6);touch-action:none;user-select:none;-webkit-user-select:none;"
             @onclick:stopPropagation="true" />
        <button style="position:absolute;top:16px;right:16px;background:rgba(255,255,255,0.15);border:none;color:#fff;font-size:24px;width:44px;height:44px;border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;line-height:1;"
                @onclick="CloseLightbox">✕</button>
        @if (_attActionTarget != null)
        {
            <button style="position:absolute;bottom:24px;left:50%;transform:translateX(-50%);background:rgba(255,255,255,0.18);border:none;color:#fff;font-size:15px;padding:10px 24px;border-radius:24px;cursor:pointer;display:flex;align-items:center;gap:8px;"
                    @onclick:stopPropagation="true"
                    @onclick="SaveLightboxImage"
                    disabled="@_attSaving">
                @(_attSaving ? "Saving..." : "⬇ Save to Downloads")
            </button>
        }
    </div>
}

@* ── Context menu (desktop only; mobile uses header action bar) ──── *@
@if (_showMenu && !MobileMode)
{
    <div style="position:fixed;inset:0;z-index:999;" @onclick="CloseMenu" @onclick:stopPropagation="true"></div>
    <div class="ctx-menu" id="ctx-menu-@Message.MessageId" style="left:@(_menuX)px;top:@(_menuY)px;visibility:hidden;">

        @* ── Reaction strip (Telegram-style) ────────────────────────── *@
        <div class="ctx-reaction-strip">
            @foreach (var emoji in _quickReactions)
            {
                var isActive = Reactions != null && Reactions.Any(r => r.Emoji == emoji && r.Sender == UserEmail);
                <button class="ctx-reaction-btn @(isActive ? "active" : "")"
                        @onclick="@(() => PickReaction(emoji))"
                        @onclick:stopPropagation="true">@emoji</button>
            }
        </div>
        <div class="ctx-divider"></div>

        @* ── Menu items ─────────────────────────────────────────────── *@
        @if (!string.IsNullOrEmpty(_selectedText))
        {
            <div class="ctx-item" @onclick="ReplyWithQuoteClicked" @onclick:stopPropagation="true">
                <span class="ctx-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 17 4 12 9 7"/><path d="M20 18v-2a4 4 0 0 0-4-4H4"/></svg></span> Reply with quote
            </div>
        }
        <div class="ctx-item" @onclick="ReplyClicked" @onclick:stopPropagation="true">
            <span class="ctx-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 17 4 12 9 7"/><path d="M20 18v-2a4 4 0 0 0-4-4H4"/></svg></span> Reply
        </div>
        <div class="ctx-item" @onclick="CopyClicked" @onclick:stopPropagation="true">
            <span class="ctx-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg></span> Copy text
        </div>
        <div class="ctx-item" @onclick="ForwardClicked" @onclick:stopPropagation="true">
            <span class="ctx-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 17 20 12 15 7"/><path d="M4 18v-2a4 4 0 0 1 4-4h12"/></svg></span> Forward
        </div>
        @if (IsOwn)
        {
            <div class="ctx-item" @onclick="EditClicked" @onclick:stopPropagation="true">
                <span class="ctx-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></span> Edit
            </div>
        }
        @if (FileAttachments.Any())
        {
            <div class="ctx-divider"></div>
            @foreach (var att in FileAttachments)
            {
                var a = att;
                var shortName = a.FileName.Length > 22 ? a.FileName[..20] + "…" : a.FileName;
                <div class="ctx-item" @onclick="@(() => ContextOpenAtt(a))" @onclick:stopPropagation="true">
                    <span class="ctx-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                    </span> Open @shortName
                </div>
                <div class="ctx-item" @onclick="@(() => ContextSaveAtt(a))" @onclick:stopPropagation="true">
                    <span class="ctx-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    </span> Save @shortName
                </div>
            }
        }
        <div class="ctx-divider"></div>
        <div class="ctx-item ctx-danger" @onclick="DeleteForMeClicked" @onclick:stopPropagation="true">
            <span class="ctx-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg></span> Delete for me
        </div>
        @if (IsOwn)
        {
            <div class="ctx-item ctx-danger" @onclick="DeleteForAllClicked" @onclick:stopPropagation="true">
                <span class="ctx-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg></span> Delete for everyone
            </div>
        }
    </div>
}

<style>
    .ctx-menu {
        position: fixed;
        background: var(--surface, #fff);
        border: 1px solid var(--border, #e8e8e8);
        border-radius: 8px;
        padding: 4px 0;
        z-index: 1000;
        box-shadow: 0 8px 24px rgba(0,0,0,.15);
        min-width: 210px;
    }
    .ctx-reaction-strip {
        display: flex;
        align-items: center;
        gap: 2px;
        padding: 6px 8px;
    }
    .ctx-reaction-btn {
        width: 36px;
        height: 36px;
        border: none;
        background: none;
        cursor: pointer;
        font-size: 22px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.1s, transform 0.1s;
        line-height: 1;
    }
    .ctx-reaction-btn:hover {
        background: var(--surface-variant, #f0f0f0);
        transform: scale(1.2);
    }
    .ctx-reaction-btn.active {
        background: rgba(91, 166, 66, 0.18);
    }
    .ctx-divider {
        border-top: 1px solid var(--border, #f0f0f0);
        margin: 4px 0;
    }
    .ctx-item {
        padding: 6px 14px;
        cursor: pointer;
        font-size: 13px;
        display: flex;
        align-items: center;
        gap: 9px;
        color: var(--text-primary, #222);
        user-select: none;
        white-space: nowrap;
    }
    .ctx-item:hover { background: var(--surface-variant, #f5f5f5); }
    .ctx-icon { font-size: 14px; width: 18px; text-align: center; }
    .ctx-danger { color: var(--error, #e53935); }
    .ctx-danger .ctx-icon { color: var(--error, #e53935); }

    .message-reactions-inline {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 4px;
        flex: 1;
    }
    .reaction-badge {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        padding: 2px 8px;
        border: 1px solid var(--divider);
        border-radius: 12px;
        background: var(--surface-variant);
        color: var(--text-primary);
        cursor: pointer;
        font-size: 13px;
        line-height: 1.3;
        transition: all 0.15s;
    }
    .reaction-badge:hover {
        background: var(--surface);
    }
    .reaction-badge.active {
        border-color: #5BA642;
        background: rgba(91, 166, 66, 0.2);
    }
    .reaction-count {
        font-size: 11px;
        opacity: 0.75;
        min-width: 8px;
        text-align: center;
    }
    .mob-msg-selected {
        background: rgba(91, 143, 217, 0.18);
        border-radius: 6px;
    }
</style>

@code {
    [Parameter] public ChatMessage Message { get; set; } = null!;
    [Parameter] public bool IsOwn { get; set; }
    [Parameter] public string? SenderDisplayName { get; set; }
    [Parameter] public string? SenderColor { get; set; }
    [Parameter] public ChatMessage? QuotedMessage { get; set; }
    [Parameter] public string? QuotedSenderName { get; set; }
    [Parameter] public EventCallback<ChatMessage> OnReply { get; set; }
    [Parameter] public EventCallback<ChatMessage> OnEdit { get; set; }
    [Parameter] public EventCallback<ChatMessage> OnDeleteForMe { get; set; }
    [Parameter] public EventCallback<ChatMessage> OnDeleteForAll { get; set; }
    [Parameter] public EventCallback<ChatMessage> OnForward { get; set; }
    [Parameter] public EventCallback<string> OnScrollToQuoted { get; set; }
    [Parameter] public List<Attachment>? Attachments { get; set; }
    [Parameter] public List<MessageReaction>? Reactions { get; set; }
    [Parameter] public EventCallback<(string Emoji, ChatMessage Message)> OnReact { get; set; }
    [Parameter] public string? UserEmail { get; set; }
    [Parameter] public bool MobileMode { get; set; }
    [Parameter] public bool IsSelected { get; set; }
    [Parameter] public EventCallback<ChatMessage> OnSelected { get; set; }

    private bool _showMenu;
    private double _menuX, _menuY;
    private string _selectedText = "";
    private string? _lightboxUrl;
    private bool _lightboxJsInit;
    private Attachment? _attActionTarget;
    private bool _attSaving;

    private readonly string[] _quickReactions = ["👍", "❤️", "😂", "😮", "😢", "🔥"];

    private async Task ShowContextMenu(MouseEventArgs e)
    {
        if (MobileMode)
        {
            await OnSelected.InvokeAsync(Message);
            return;
        }
        _selectedText = await JS.InvokeAsync<string>("getSelectedText");
        _menuX = e.ClientX;
        _menuY = e.ClientY;
        _showMenu = true;
    }

    private void CloseMenu() => _showMenu = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_lightboxUrl != null && !_lightboxJsInit)
        {
            _lightboxJsInit = true;
            await JS.InvokeVoidAsync("initLightboxZoom");
        }
        if (_showMenu)
            await JS.InvokeVoidAsync("positionMenu",
                $"ctx-menu-{Message.MessageId}", _menuX, _menuY);
    }

    private async Task PickReaction(string emoji)
    {
        _showMenu = false;
        await OnReact.InvokeAsync((emoji, Message));
    }

    private async Task ReplyClicked()
    {
        _showMenu = false;
        await OnReply.InvokeAsync(Message);
    }

    private async Task ReplyWithQuoteClicked()
    {
        _showMenu = false;
        await OnReply.InvokeAsync(Message);
    }

    private async Task CopyClicked()
    {
        _showMenu = false;
        var text = string.IsNullOrEmpty(_selectedText) ? Message.Content : _selectedText;
        await JS.InvokeVoidAsync("copyToClipboard", text);
    }

    private async Task EditClicked()
    {
        _showMenu = false;
        await OnEdit.InvokeAsync(Message);
    }

    private async Task DeleteForMeClicked()
    {
        _showMenu = false;
        await OnDeleteForMe.InvokeAsync(Message);
    }

    private async Task DeleteForAllClicked()
    {
        _showMenu = false;
        await OnDeleteForAll.InvokeAsync(Message);
    }

    private async Task ForwardClicked()
    {
        _showMenu = false;
        await OnForward.InvokeAsync(Message);
    }

    private string GetAttachmentUrl(Attachment att)
    {
        var absPath = DbPathInfo.ResolveFilePath(att.FilePath);
        if (!string.IsNullOrEmpty(absPath) && System.IO.File.Exists(absPath))
        {
            var bytes = System.IO.File.ReadAllBytes(absPath);
            return $"data:{att.ContentType};base64,{Convert.ToBase64String(bytes)}";
        }
        return "";
    }

    private void OpenImage(Attachment att)
    {
        var url = GetAttachmentUrl(att);
        if (!string.IsNullOrEmpty(url))
        {
            _lightboxUrl = url;
            _lightboxJsInit = false;
            _attActionTarget = att;
        }
    }

    private void CloseLightbox()
    {
        _lightboxUrl = null;
        _lightboxJsInit = false;
        _attActionTarget = null;
    }

    private async Task CloseLightboxSafe()
    {
        // If zoomed in — reset zoom first; second tap closes
        var zoomed = await JS.InvokeAsync<bool>("isLightboxZoomed");
        if (zoomed)
        {
            await JS.InvokeVoidAsync("resetLightboxZoom");
            _lightboxJsInit = false; // allow re-init on next render
        }
        else
        {
            CloseLightbox();
        }
    }

    private IEnumerable<Attachment> FileAttachments =>
        Attachments?.Where(a => !a.IsImage) ?? Enumerable.Empty<Attachment>();

    private void OnAttachmentClick(Attachment att)
    {
        if (PlatformService.SupportsMauiFilePicker)
            _ = OpenFileDirect(att);
        else
            _ = DownloadFile(att);
    }

    private async Task OpenFileDirect(Attachment att)
    {
        var absPath = DbPathInfo.ResolveFilePath(att.FilePath);
        if (!string.IsNullOrEmpty(absPath) && System.IO.File.Exists(absPath))
            await PlatformService.OpenAttachmentAsync(absPath, att.FileName, att.ContentType ?? "application/octet-stream");
    }

    private async Task ContextOpenAtt(Attachment att)
    {
        _showMenu = false;
        if (PlatformService.SupportsMauiFilePicker)
            await OpenFileDirect(att);
        else
            await DownloadFile(att);
    }

    private async Task ContextSaveAtt(Attachment att)
    {
        _showMenu = false;
        if (PlatformService.SupportsMauiFilePicker)
        {
            var absPath = DbPathInfo.ResolveFilePath(att.FilePath);
            if (!string.IsNullOrEmpty(absPath) && System.IO.File.Exists(absPath))
            {
                var bytes = await System.IO.File.ReadAllBytesAsync(absPath);
                await PlatformService.SaveToDownloadsAsync(att.FileName, bytes, att.ContentType ?? "application/octet-stream");
            }
        }
        else
        {
            await DownloadFile(att);
        }
    }

    private async Task SaveLightboxImage()
    {
        if (_attActionTarget == null) return;
        _attSaving = true;
        StateHasChanged();
        var target = _attActionTarget;
        _attActionTarget = null;
        var absPath = DbPathInfo.ResolveFilePath(target.FilePath);
        if (!string.IsNullOrEmpty(absPath) && System.IO.File.Exists(absPath))
        {
            var bytes = await System.IO.File.ReadAllBytesAsync(absPath);
            await PlatformService.SaveToDownloadsAsync(target.FileName, bytes, target.ContentType ?? "image/jpeg");
        }
        _attSaving = false;
    }

    private async Task DownloadFile(Attachment att)
    {
        var url = GetAttachmentUrl(att);
        if (!string.IsNullOrEmpty(url))
        {
            await JS.InvokeVoidAsync("eval", $@"(function() {{
                var a = document.createElement('a');
                a.href = '{url}';
                a.download = '{att.FileName}';
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
            }})();");
        }
    }

    private string FormatSize(long bytes)
    {
        if (bytes < 1024) return bytes + " B";
        if (bytes < 1024 * 1024) return (bytes / 1024.0).ToString("F1") + " KB";
        return (bytes / (1024.0 * 1024.0)).ToString("F1") + " MB";
    }

    private string FormatTime(DateTimeOffset timestamp)
    {
        var local = timestamp.ToLocalTime();
        var now = DateTimeOffset.Now;
        var diff = now - timestamp;
        if (diff.TotalDays < 1) return local.ToString("HH:mm");
        if (diff.TotalDays < 7) return local.ToString("ddd HH:mm");
        return local.ToString("MMM d, HH:mm");
    }
}
