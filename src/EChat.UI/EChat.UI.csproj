<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<NoWarn>CS8600;CS8601;CS8602;CS8603;CS8604;CS0168;CS0219;CS0162</NoWarn>
		<RootNamespace>EChat.UI</RootNamespace>
		<AddRazorSupportForMvc>true</AddRazorSupportForMvc>
		<DebugType Condition="'$(Configuration)'=='Release'">none</DebugType>
		<DebugSymbols Condition="'$(Configuration)'=='Release'">false</DebugSymbols>
		<Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)version.txt').Trim())</Version>
		<AssemblyVersion>$(Version)</AssemblyVersion>
		<InformationalVersion>$(Version)+$([System.DateTime]::UtcNow.ToString("yyyyMMddHHmm"))</InformationalVersion>
	</PropertyGroup>

	<!-- Track version.txt so MSBuild incremental build detects version bumps even without .cs changes -->
	<ItemGroup>
		<UpToDateCheckInput Include="$(MSBuildThisFileDirectory)version.txt" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
		<PackageReference Include="Net.Codecrete.QrCodeGenerator" Version="2.1.0" />
		<PackageReference Include="Markdig" Version="0.37.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\EChat.Core\EChat.Core.csproj" />
	</ItemGroup>

</Project>