@page "/about"
@using EChat.Core.Services
@using EChat.Core.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.DependencyInjection
@inject NavigationManager Navigation
@inject IServiceScopeFactory ScopeFactory
@inject EChat.Core.ServiceCollectionExtensions.DatabasePathInfo DbPathInfo

<div class="settings-page">
    <div class="settings-page-header">
        <button class="back-btn" @onclick="GoBack">←</button>
        <h1>About</h1>
    </div>

    <div class="settings-body">
        <div class="settings-section">
            <h2>εChat (epsilon Chat)</h2>

            <div class="settings-info-row">
                <span class="settings-info-label">Version</span>
                <span>@VersionInfo.AppVersion<br/>@VersionInfo.BuildDate · @VersionInfo.Platform</span>
            </div>

            @foreach (var lib in VersionInfo.Libraries.Where(l => l.Name.StartsWith("EChat")))
            {
                <div class="settings-info-row">
                    <span class="settings-info-label">@lib.Name</span>
                    <span>@lib.Version</span>
                </div>
            }

            <div class="settings-info-row">
                <span class="settings-info-label">.NET</span>
                <span>@VersionInfo.RuntimeVersion</span>
            </div>

            @foreach (var lib in VersionInfo.Libraries.Where(l => !l.Name.StartsWith("EChat")))
            {
                <div class="settings-info-row">
                    <span class="settings-info-label">@lib.Name</span>
                    <span>@lib.Version</span>
                </div>
            }

            <div class="settings-info-row">
                <span class="settings-info-label">Protocol</span>
                <span>IMAP + SMTP</span>
            </div>

            <div class="settings-info-row">
                <span class="settings-info-label">DB</span>
                <span class="db-path">@DbPathInfo.Path</span>
            </div>

            <div class="settings-info-row">
                <a href="@VersionInfo.ProjectUrl" target="_blank" style="color:var(--primary);text-decoration:none;">@VersionInfo.ProjectUrl</a>
            </div>

        </div>
    </div>
</div>

@code {
    private void GoBack() => Navigation.NavigateTo("/chats");
}