@page "/chats"
@using EChat.Core.Models
@using EChat.Core.Data
@using EChat.Core.Protocol
@using EChat.Core.Transport
@using EChat.UI.Services
@using EChat.UI.Components
@using Microsoft.EntityFrameworkCore
@using Net.Codecrete.QrCodeGenerator
@inject ChatDbContext DbContext
@inject NavigationManager Navigation
@inject EmailTransportService TransportService
@inject UserContextService UserContext
@inject IPlatformService PlatformService
@inject IAppPreferences Prefs
@inject IJSRuntime JS
@inject ChatEventService ChatEvents
@implements IDisposable

@if (PlatformService.IsDesktop)
{
    <!-- ══════════════════════════════════════
         Windows — three-column desktop layout
    ══════════════════════════════════════ -->
    <div class="desktop-layout">

        <!-- ─── Account column ─── -->
        <div class="account-column">
            @if (accounts != null)
            {
                @foreach (var acc in accounts)
                {
                    <div style="position:relative;display:inline-block;">
                        <button class="account-avatar-btn @(acc.AccountId == activeAccountId ? "active" : "")"
                                title="@acc.DisplayName (@acc.Email)"
                                style="background-color: @(acc.AvatarColor ?? "#5BA642")"
                                @onclick="@(() => SwitchAccount(acc.AccountId))">
                            @acc.DisplayName.Substring(0, 1).ToUpper()
                        </button>
                        @if (accountUnreadCounts.GetValueOrDefault(acc.AccountId) > 0 && acc.AccountId != activeAccountId)
                        {
                            <span style="position:absolute;top:-4px;right:-4px;background:#e53935;color:#fff;border-radius:999px;min-width:16px;height:16px;font-size:10px;font-weight:700;display:flex;align-items:center;justify-content:center;padding:0 3px;pointer-events:none;">
                                @accountUnreadCounts[acc.AccountId]
                            </span>
                        }
                    </div>
                }
            }
            <button class="account-add-btn" title="Add account"
                    @onclick="@(() => Navigation.NavigateTo("/setup"))">+</button>
            <div class="account-spacer"></div>
            <button class="account-settings-btn" title="Account settings"
                    @onclick="OpenAccountSettings">⚙</button>
            <button class="account-global-btn" title="App settings"
                    @onclick="@(() => Navigation.NavigateTo("/settings"))">☰</button>
        </div>

        <!-- ─── Chat list panel ─── -->
        <div class="left-panel">
            <div class="left-header">
                <span class="app-title">@(activeAccount?.DisplayName ?? "εChat")</span>
                <button class="icon-btn" title="New chat" @onclick="OpenNewChat">(+)</button>
            </div>

            <div class="search-bar">
                <div style="display:flex;flex-direction:row;align-items:center;gap:8px;width:100%;">
                    <span style="flex:0 0 26px;width:26px;height:26px;display:inline-flex;align-items:center;justify-content:center;border-radius:2px;font-size:12px;font-weight:700;cursor:pointer;user-select:none;border:1px solid @(showArchived ? "var(--primary)" : "rgba(0,0,0,0.22)");background:@(showArchived ? "var(--primary)" : "rgba(0,0,0,0.04)");color:@(showArchived ? "#fff" : "var(--text-secondary)");text-decoration:@(showArchived ? "none" : "line-through");"
                          title="@(showArchived ? "Hide archived" : "Show archived")"
                          @onclick="async () => { showArchived = !showArchived; await LoadChatsAsync(); }">A</span>
                    <input type="text"
                           class="search-input"
                           style="flex:1 1 0;min-width:0;"
                           placeholder="Search chats..."
                           @bind="searchQuery"
                           @bind:event="oninput" />
                </div>
            </div>

            <div class="chat-list">
                @if (chats == null)
                {
                    <div class="empty-state"><p>Loading...</p></div>
                }
                else if (!FilteredChats.Any())
                {
                    <div class="empty-state">
                        <div class="empty-state-icon">💬</div>
                        <p>@(string.IsNullOrEmpty(searchQuery) ? "No chats yet" : "No chats found")</p>
                    </div>
                }
                else
                {
                    @foreach (var chat in FilteredChats)
                    {
                        <div class="chat-item @(chat.ChatId == selectedChatId ? "active" : "") @(chat.Archived ? "chat-item-archived" : "")"
                             @onclick="@(() => SelectChat(chat.ChatId))">
                            <div class="chat-avatar @(chat.Type == ChatType.Group ? "chat-avatar-group" : "")">
                                @chat.Name.Substring(0, 1).ToUpper()
                            </div>
                            <div class="chat-content">
                                <div class="chat-item-top">
                                    <span class="chat-name">@chat.Name</span>
                                    <span class="chat-time">@FormatTime(chat.LastActivityAt)</span>
                                </div>
                                <div class="chat-preview">
                                    @if (chat.Archived)
                                    {
                                        <a class="unarchive-link"
                                           href="javascript:void(0)"
                                           @onclick:stopPropagation="true"
                                           @onclick="@(() => ToggleArchiveFromMenu(chat.ChatId, false))">Unarchive</a>
                                    }
                                    else if (chat.UnreadCount > 0)
                                    {
                                        <span>New messages</span>
                                        <span class="chat-badge">@chat.UnreadCount</span>
                                    }
                                    else
                                    {
                                        <span class="preview-placeholder">···</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- ─── Chat view panel ─── -->
        <div class="right-panel">
            @if (selectedChatId == null)
            {
                <div class="no-chat-selected">
                    <div class="no-chat-icon">💬</div>
                    <p>Select a chat to start messaging</p>
                </div>
            }
            else
            {
                <div class="chat-view-header">
                    <div class="chat-view-header-info">
                        <div class="chat-view-avatar @(selectedChat?.Type == ChatType.Group ? "chat-avatar-group" : "")">
                            @(selectedChat?.Name.Substring(0, 1).ToUpper())
                        </div>
                        <span class="chat-view-name">@selectedChat?.Name</span>
                    </div>
                    <button class="icon-btn icon-btn-dark" @onclick="ShowChatInfo" title="Chat info">ℹ</button>
                </div>

                <div class="messages-container" @ref="messagesContainer">
                    @if (messages == null)
                    {
                        <p class="loading">Loading messages...</p>
                    }
                    else if (!messages.Any())
                    {
                        <div class="messages-empty"><p>No messages yet. Say hello!</p></div>
                    }
                    else
                    {
                        @foreach (var message in messages)
                        {
                            var quotedMsg = message.InReplyTo != null
                                ? messagesById.GetValueOrDefault(message.InReplyTo)
                                : null;
                            var quotedSender = quotedMsg != null
                                ? contactNames.GetValueOrDefault(quotedMsg.Sender, quotedMsg.Sender.Split('@')[0])
                                : null;
                            <MessageBubble Message="@message"
                                           IsOwn="@IsOwnMessage(message)"
                                           SenderDisplayName="@(contactNames.GetValueOrDefault(message.Sender, message.Sender.Split('@')[0]))"
                                           QuotedMessage="@quotedMsg"
                                           QuotedSenderName="@quotedSender"
                                           OnReply="@StartReply"
                                           OnEdit="@StartEdit"
                                           OnDeleteForMe="@DeleteMessageForMe"
                                           OnDeleteForAll="@DeleteMessageForAll"
                                           OnForward="@StartForward"
                                           OnScrollToQuoted="@ScrollToMessage" />
                        }
                    }
                </div>

                @if (!string.IsNullOrEmpty(sendError))
                {
                    <div class="send-error">@sendError</div>
                }

                @* ── Reply / Edit strip ──────────────────────────────── *@
                @if (replyingToMessage != null)
                {
                    <div style="display:flex;align-items:center;gap:8px;padding:6px 12px;
                                background:rgba(91,166,66,.08);border-top:1px solid rgba(91,166,66,.3);">
                        <div style="flex:1;border-left:3px solid var(--primary,#5BA642);padding-left:8px;font-size:12px;">
                            <div style="font-weight:600;color:var(--primary,#5BA642);">
                                @(contactNames.GetValueOrDefault(replyingToMessage.Sender, replyingToMessage.Sender.Split('@')[0]))
                            </div>
                            <div style="color:#555;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:400px;">
                                @(replyingToMessage.Content.Length > 60 ? replyingToMessage.Content[..60] + "…" : replyingToMessage.Content)
                            </div>
                        </div>
                        <button style="background:none;border:none;cursor:pointer;font-size:16px;color:#888;"
                                @onclick="CancelReply">✕</button>
                    </div>
                }
                @if (editingMessage != null)
                {
                    <div style="display:flex;align-items:center;gap:8px;padding:6px 12px;
                                background:rgba(255,165,0,.08);border-top:1px solid rgba(255,165,0,.3);">
                        <div style="flex:1;font-size:12px;color:#888;">✏ Editing message</div>
                        <button style="background:none;border:none;cursor:pointer;font-size:16px;color:#888;"
                                @onclick="CancelEdit">✕</button>
                    </div>
                }

                <div class="message-input-bar">
                    <textarea class="message-textarea"
                              placeholder="@(editingMessage != null ? "Edit message…" : "Write a message...")"
                              @bind="messageText"
                              @bind:event="oninput"
                              @onkeydown="OnKeyDown"
                              rows="1"></textarea>
                    <button class="send-btn"
                            @onclick="SendMessage"
                            disabled="@(string.IsNullOrWhiteSpace(messageText))">
                        ➤
                    </button>
                </div>
            }
        </div>

    </div>

    <ChatInfoModal IsVisible="@showChatInfo"
                   ChatId="@selectedChatId"
                   OnClose="@(() => showChatInfo = false)"
                   OnChatArchived="@OnChatArchived"
                   OnChatUnarchived="@OnChatUnarchived" />

}
else
{
    <!-- ══════════════════════════════════════
         Android / iOS — mobile layout
    ══════════════════════════════════════ -->
    <div class="app-container">
        <div class="app-header">
            <h1>εChat</h1>
            <div class="app-header-actions">
                <button class="header-icon" @onclick="OpenNewChat" title="New chat">✏</button>
                <button class="header-icon" @onclick="OpenAccountSettings" title="Settings">⚙</button>
            </div>
        </div>

        <div class="search-bar">
            <input type="text"
                   class="search-input"
                   placeholder="Search chats..."
                   @bind="searchQuery"
                   @bind:event="oninput" />
        </div>

        <div class="chat-list">
            @if (chats == null)
            {
                <div class="empty-state">
                    <div class="empty-state-icon">💬</div>
                    <p>Loading chats...</p>
                </div>
            }
            else if (!FilteredChats.Any())
            {
                <div class="empty-state">
                    <div class="empty-state-icon">💬</div>
                    <p>@(string.IsNullOrEmpty(searchQuery) ? "No chats yet" : "No chats found")</p>
                </div>
            }
            else
            {
                @foreach (var chat in FilteredChats)
                {
                    <div class="chat-item" @onclick="@(() => Navigation.NavigateTo($"/chat/{chat.ChatId}"))">
                        <div class="chat-avatar @(chat.Type == ChatType.Group ? "chat-avatar-group" : "")">
                            @chat.Name.Substring(0, 1).ToUpper()
                        </div>
                        <div class="chat-content">
                            <div class="chat-header">
                                <span class="chat-name">@chat.Name</span>
                                <span class="chat-time">@FormatTime(chat.LastActivityAt)</span>
                            </div>
                            @if (chat.UnreadCount > 0)
                            {
                                <div class="chat-preview">
                                    New messages
                                    <span class="chat-badge">@chat.UnreadCount</span>
                                </div>
                            }
                            else
                            {
                                <div class="chat-preview">Tap to open chat</div>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>
}

<!-- ══════════════════════════════════════
     Forward message dialog
══════════════════════════════════════ -->
@if (showForwardDialog && forwardingMessage != null)
{
    <div class="nc-overlay" @onclick="@(() => showForwardDialog = false)">
        <div class="new-chat-modal" style="max-height:70vh;display:flex;flex-direction:column;" @onclick:stopPropagation>
            <div class="new-chat-modal-header">
                <span style="font-weight:600;font-size:15px;flex:1;">Forward to...</span>
                <button class="new-chat-close" @onclick="@(() => showForwardDialog = false)">✕</button>
            </div>
            <div style="overflow-y:auto;flex:1;padding:4px 0;">
                @if (chats != null)
                {
                    @foreach (var chat in chats.Where(c => c.ChatId != selectedChatId))
                    {
                        <div class="chat-item" @onclick="@(() => ForwardToChat(chat))" @onclick:stopPropagation>
                            <div class="chat-avatar @(chat.Type == ChatType.Group ? "chat-avatar-group" : "")">
                                @chat.Name.Substring(0, 1).ToUpper()
                            </div>
                            <div class="chat-content">
                                <div class="chat-name">@chat.Name</div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}

<!-- ══════════════════════════════════════
     New Chat modal (shared, both platforms)
══════════════════════════════════════ -->
@if (showNewChat)
{
    <div class="nc-overlay" @onclick="CloseNewChat">
        <div class="new-chat-modal" @onclick:stopPropagation>

            <!-- Tabs -->
            <div class="new-chat-modal-header">
                <button class="new-chat-tab @(newChatTab == "invite" ? "active" : "")"
                        @onclick="@(() => SwitchTab("invite"))">My Invite</button>
                <button class="new-chat-tab @(newChatTab == "add" ? "active" : "")"
                        @onclick="@(() => SwitchTab("add"))">Add Contact</button>
                <button class="new-chat-tab @(newChatTab == "group" ? "active" : "")"
                        @onclick="@(() => SwitchTab("group"))">New Group</button>
                <button class="new-chat-close" @onclick="CloseNewChat">✕</button>
            </div>

            <!-- ── MY INVITE tab ── -->
            @if (newChatTab == "invite")
            {
                <div class="new-chat-body">
                    <p class="new-chat-hint">
                        Share this invite with your contact so they can add you with verified encryption.
                    </p>

                    <!-- QR code -->
                    <div class="invite-qr-box">
                        @myInviteQr
                    </div>

                    <!-- Invite code — display only, for visual identification -->
                    <div class="invite-code-row">
                        <span class="invite-code-label">ID</span>
                        <span class="invite-code">@myInviteCode</span>
                    </div>

                    <!-- Copy button — always copies the full link (contains public key) -->
                    <div class="invite-link-row">
                        <button class="invite-copy-btn invite-copy-primary" @onclick="@(() => CopyToClipboard(myInviteLink))">
                            @(copied == "link" ? "✓ Copied!" : "Copy invite link")
                        </button>
                    </div>

                    <p class="invite-note">
                        Scan the QR code or share the link — it includes your public key so your contact can write to you with encryption from the first message.
                    </p>
                </div>
            }

            <!-- ── ADD CONTACT tab ── -->
            @if (newChatTab == "add")
            {
                <div class="new-chat-body">
                    <div class="new-chat-field">
                        <label class="new-chat-label">Invite code or link</label>
                        <input type="text"
                               class="new-chat-input"
                               placeholder="ABCDE-FGHJ2  or  echat://invite?..."
                               @bind="inviteInput"
                               @bind:event="oninput"
                               @onkeydown="OnAddContactKeyDown" />
                        <p class="invite-field-hint">Paste the code or link your contact shared with you</p>
                    </div>

                    <div class="invite-divider"><span>or add by email (unverified)</span></div>

                    <div class="new-chat-field">
                        <input type="email"
                               class="new-chat-input"
                               placeholder="contact@example.com"
                               @bind="newChatEmail"
                               @bind:event="oninput"
                               @onkeydown="OnNewChatKeyDown" />
                    </div>

                    @if (filteredContacts.Any() && !string.IsNullOrEmpty(newChatEmail))
                    {
                        <div class="new-chat-contacts">
                            @foreach (var contact in filteredContacts)
                            {
                                <div class="new-chat-contact-item" @onclick="@(() => SelectContact(contact.Email))">
                                    <div class="contact-avatar">
                                        @((contact.DisplayName ?? contact.Email).Substring(0, 1).ToUpper())
                                    </div>
                                    <div class="contact-info">
                                        <span class="contact-name">@(contact.DisplayName ?? contact.Email)</span>
                                        <span class="contact-email">@contact.Email</span>
                                        @if (contact.Verified)
                                        {
                                            <span class="contact-verified">✓ verified</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(newChatError))
                    {
                        <p class="new-chat-error">@newChatError</p>
                    }

                    <div class="new-chat-actions">
                        <button class="new-chat-btn-primary"
                                @onclick="AddContactFromInviteOrEmail"
                                disabled="@(string.IsNullOrWhiteSpace(inviteInput) && string.IsNullOrWhiteSpace(newChatEmail))">
                            Start Chat
                        </button>
                    </div>
                </div>
            }

            <!-- ── NEW GROUP tab ── -->
            @if (newChatTab == "group")
            {
                <div class="new-chat-body">
                    <div class="new-chat-field">
                        <label class="new-chat-label">Group name</label>
                        <input type="text"
                               class="new-chat-input"
                               placeholder="My Group"
                               @bind="newGroupName"
                               @bind:event="oninput" />
                    </div>

                    <div class="new-chat-field">
                        <label class="new-chat-label">Members</label>
                        @for (int i = 0; i < groupMemberEmails.Count; i++)
                        {
                            var idx = i;
                            <div class="group-member-row">
                                <input type="email"
                                       class="new-chat-input"
                                       placeholder="member@example.com"
                                       value="@groupMemberEmails[idx]"
                                       @oninput="@(e => groupMemberEmails[idx] = e.Value?.ToString() ?? "")" />
                                <button class="group-member-remove"
                                        @onclick="@(() => RemoveGroupMember(idx))"
                                        disabled="@(groupMemberEmails.Count <= 1)">✕</button>
                            </div>
                        }
                        <button class="new-chat-btn-secondary" @onclick="AddGroupMember">+ Add member</button>
                    </div>

                    @if (!string.IsNullOrEmpty(newChatError))
                    {
                        <p class="new-chat-error">@newChatError</p>
                    }

                    <div class="new-chat-actions">
                        <button class="new-chat-btn-primary"
                                @onclick="CreateGroup"
                                disabled="@string.IsNullOrWhiteSpace(newGroupName)">
                            Create Group
                        </button>
                    </div>
                </div>
            }

        </div>
    </div>
}

@code {
    // Accounts
    private List<Account>? accounts;
    private string? activeAccountId;
    private Account? activeAccount;
    private string _subjectTemplate = "[εChat] {chatName}";

    // Shared
    private List<Chat>? chats;
    private string searchQuery = string.Empty;

    private IEnumerable<Chat> FilteredChats =>
        chats?.Where(c => string.IsNullOrEmpty(searchQuery) ||
                          c.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
              .OrderByDescending(c => c.LastActivityAt) ?? Enumerable.Empty<Chat>();

    // Desktop only
    private string? selectedChatId;
    private Chat? selectedChat;
    private List<ChatMessage>? messages;
    private List<string>? recipients;
    private string messageText = string.Empty;
    private ElementReference messagesContainer;
    private bool showChatInfo = false;
    private bool _scrollToBottom = false;

    // Archived chats toggle
    private bool showArchived = false;

    // Contact display names: email → name
    private Dictionary<string, string> contactNames = new(StringComparer.OrdinalIgnoreCase);

    // Unread counts per account (sum of non-muted, non-archived chats)
    private Dictionary<string, int> accountUnreadCounts = new(StringComparer.OrdinalIgnoreCase);

    // MessageId → ChatMessage for quick quoted-message lookup
    private Dictionary<string, ChatMessage> messagesById = new(StringComparer.OrdinalIgnoreCase);

    // Reply / edit / forward state
    private ChatMessage? replyingToMessage;
    private ChatMessage? editingMessage;
    private ChatMessage? forwardingMessage;
    private bool showForwardDialog;

    // New chat modal
    private bool showNewChat = false;
    private string newChatTab = "invite";
    private string newChatEmail = string.Empty;
    private string inviteInput = string.Empty;
    private string newGroupName = string.Empty;
    private List<string> groupMemberEmails = new() { "" };
    private string newChatError = string.Empty;
    private string copied = string.Empty;
    private List<Contact> allContacts = new();

    // My invite data
    private string myInviteCode = string.Empty;
    private string myInviteLink = string.Empty;
    private MarkupString myInviteQr;

    private IEnumerable<Contact> filteredContacts =>
        string.IsNullOrWhiteSpace(newChatEmail)
            ? Enumerable.Empty<Contact>()
            : allContacts.Where(c =>
                c.Email.Contains(newChatEmail, StringComparison.OrdinalIgnoreCase) ||
                (c.DisplayName ?? "").Contains(newChatEmail, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadAccountsAsync();
        await LoadChatsAsync();
        allContacts = await DbContext.Contacts.OrderBy(c => c.DisplayName).ToListAsync();
        contactNames = allContacts.ToDictionary(c => c.Email, c => c.DisplayName ?? c.Email.Split('@')[0], StringComparer.OrdinalIgnoreCase);
        ChatEvents.ChatUpdated += OnChatUpdated;
    }

    public void Dispose()
    {
        ChatEvents.ChatUpdated -= OnChatUpdated;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrollToBottom)
        {
            _scrollToBottom = false;
            try
            {
                await JS.InvokeVoidAsync("eval",
                    "var el=document.querySelector('.messages-container');" +
                    "if(el)el.scrollTop=el.scrollHeight;");
            }
            catch { }
        }
    }

    private void OnChatUpdated(string chatId)
    {
        InvokeAsync(async () =>
        {
            await LoadChatsAsync();
            if (selectedChatId == chatId)
            {
                await LoadMessagesAsync();
                await ClearUnreadAsync(chatId); // auto-clear if user is already reading
                _scrollToBottom = true;
            }
            StateHasChanged();
        });
    }

    private async Task LoadAccountsAsync()
    {
        accounts = await DbContext.Accounts.ToListAsync();
        activeAccount = accounts.FirstOrDefault(a => a.IsActive)
                        ?? accounts.FirstOrDefault();
        activeAccountId = activeAccount?.AccountId;

        if (activeAccount != null && string.IsNullOrEmpty(UserContext.AccountId))
        {
            var deviceId = Prefs.Get("device_id", string.Empty);
            UserContext.Initialize(activeAccount.AccountId, activeAccount.Email, deviceId);
        }

        await LoadSubjectTemplateAsync();
    }

    private async Task LoadSubjectTemplateAsync()
    {
        if (activeAccountId == null) return;
        var setting = await DbContext.Settings.FindAsync($"acct_{activeAccountId}_subject_template");
        _subjectTemplate = setting?.Value ?? "[εChat] {chatName}";
    }

    private async Task LoadChatsAsync()
    {
        // AsNoTracking is critical: the long-lived Blazor DbContext caches entities via
        // the identity map. Without it, UnreadCount incremented by IncomingMessageService
        // (separate scope) would be silently returned as the old tracked value (0).
        var query = DbContext.Chats.AsNoTracking().AsQueryable();
        if (!showArchived)
            query = query.Where(c => !c.Archived);
        if (!string.IsNullOrEmpty(activeAccountId))
            query = query.Where(c => c.AccountId == activeAccountId || c.AccountId == null);

        var list = await query.ToListAsync();
        chats = list.OrderByDescending(c => c.LastActivityAt).ToList();

        await UpdateAccountUnreadCountsAsync();
    }

    private async Task UpdateAccountUnreadCountsAsync()
    {
        if (accounts == null) return;
        var unreadChats = await DbContext.Chats
            .AsNoTracking()
            .Where(c => !c.Muted && !c.Archived && c.UnreadCount > 0 && c.AccountId != null)
            .ToListAsync();
        accountUnreadCounts = accounts.ToDictionary(
            a => a.AccountId,
            a => unreadChats.Where(c => c.AccountId == a.AccountId).Sum(c => c.UnreadCount),
            StringComparer.OrdinalIgnoreCase);
    }

    private async Task OnChatArchived(string chatId)
    {
        await LoadChatsAsync();
        // If the archived chat was selected, deselect it (unless showing archived)
        if (!showArchived && selectedChatId == chatId)
        {
            selectedChatId = null;
            selectedChat = null;
            messages = null;
            recipients = null;
        }
        StateHasChanged();
    }

