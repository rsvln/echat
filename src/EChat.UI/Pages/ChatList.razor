    private async Task CreateGroup()
    {
        newChatError = string.Empty;
        var name = newGroupName.Trim();

        if (string.IsNullOrEmpty(name))
        {
            newChatError = "Group name is required.";
            return;
        }

        var validEmails = groupMemberEmails
            .Select(e => e.Trim())
            .Where(e => !string.IsNullOrEmpty(e) && e.Contains('@'))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        var chatId = Guid.NewGuid().ToString();

        var chat = new Chat
        {
            ChatId = chatId,
            Type = ChatType.Group,
            Name = name,
            AccountId = activeAccountId,
            CreatedAt = DateTimeOffset.UtcNow,
            LastActivityAt = DateTimeOffset.UtcNow
        };
        DbContext.Chats.Add(chat);

        var group = new ChatGroup
        {
            GroupId = chatId,
            Name = name,
            Version = 1,
            CreatedAt = DateTimeOffset.UtcNow
        };
        DbContext.Groups.Add(group);

        // Add current user as admin
        if (!string.IsNullOrEmpty(UserContext.UserEmail))
        {
            DbContext.GroupMembers.Add(new GroupMember
            {
                GroupId = chatId,
                MemberEmail = UserContext.UserEmail,
                Role = GroupRole.Admin,
                AddedAt = DateTimeOffset.UtcNow
            });
        }

        // Add members
        foreach (var email in validEmails)
        {
            if (email.Equals(UserContext.UserEmail, StringComparison.OrdinalIgnoreCase))
                continue;

            DbContext.GroupMembers.Add(new GroupMember
            {
                GroupId = chatId,
                MemberEmail = email,
                Role = GroupRole.Member,
                AddedAt = DateTimeOffset.UtcNow,
                AddedBy = UserContext.UserEmail
            });

            // Ensure contact exists
            if (await DbContext.Contacts.FindAsync(email) == null)
            {
                DbContext.Contacts.Add(new Contact
                {
                    Email = email,
                    DisplayName = email.Split('@')[0]
                });
            }
        }

        await DbContext.SaveChangesAsync();
        allContacts = await DbContext.Contacts.OrderBy(c => c.DisplayName).ToListAsync();
        await LoadChatsAsync();

        CloseNewChat();
        if (PlatformService.IsDesktop)
            await SelectChat(chatId);
        else
            Navigation.NavigateTo($"/chat/{chatId}");
    }

