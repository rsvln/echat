    private async Task CreateChatFromInvite(string input)
    {
        string email;
        string displayName;
        bool verified = true;

        // Try parse as echat:// link
        string? invitePublicKey = null;
        if (input.StartsWith("echat://invite", StringComparison.OrdinalIgnoreCase))
        {
            try
            {
                var uri = new Uri(input);
                var pairs = uri.Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries)
                    .Select(p => p.Split('=', 2))
                    .Where(p => p.Length == 2)
                    .ToDictionary(p => Uri.UnescapeDataString(p[0]), p => Uri.UnescapeDataString(p[1]),
                                  StringComparer.OrdinalIgnoreCase);
                email = pairs.GetValueOrDefault("e", string.Empty);
                displayName = pairs.GetValueOrDefault("n", string.Empty);
                invitePublicKey = pairs.GetValueOrDefault("k");
            }
            catch
            {
                newChatError = "Invalid invite link.";
                return;
            }
        }
        // Looks like a code: XXXXX-YYYYY
        else if (System.Text.RegularExpressions.Regex.IsMatch(input, @"^[A-Z0-9]{5}-[A-Z0-9]{5}$", System.Text.RegularExpressions.RegexOptions.IgnoreCase))
        {
            // Code-only invite: we need email too. Ask for email.
            newChatError = "Invite code recognized. Please also enter their email address below.";
            return;
        }
        else
        {
            newChatError = "Unrecognized invite format. Expected a code (XXXXX-YYYYY) or echat:// link.";
            return;
        }

        if (string.IsNullOrEmpty(email) || !email.Contains('@'))
        {
            newChatError = "Invite does not contain a valid email.";
            return;
        }

        await StartOrOpenChat(email, displayName, verified, invitePublicKey);
    }

    private async Task CreateDirectChat()
    {
        newChatError = string.Empty;
        var email = newChatEmail.Trim();

        if (string.IsNullOrEmpty(email) || !email.Contains('@'))
        {
            newChatError = "Enter a valid email address.";
            return;
        }

        if (email.Equals(UserContext.UserEmail, StringComparison.OrdinalIgnoreCase))
        {
            newChatError = "You can't chat with yourself.";
            return;
        }

        await StartOrOpenChat(email, email.Split('@')[0], verified: false, publicKey: null);
    }

    private async Task StartOrOpenChat(string email, string displayName, bool verified, string? publicKey = null)
    {
        // Find existing chat with this contact — skip deleted ones
        var existingChat = await DbContext.Chats
            .Where(c => c.Type == ChatType.OneToOne &&
                        !c.Deleted &&
                        (c.AccountId == activeAccountId || c.AccountId == null) &&
                        c.PartnerEmail == email)
            .FirstOrDefaultAsync();

        if (existingChat == null)
        {
            // Fallback: check by chat name (for chats created before PartnerEmail was added)
            var fallbackName = string.IsNullOrEmpty(displayName) ? email.Split('@')[0] : displayName;
            existingChat = await DbContext.Chats
                .Where(c => c.Type == ChatType.OneToOne &&
                            !c.Deleted &&
                            (c.AccountId == activeAccountId || c.AccountId == null) &&
                            (c.Name == fallbackName || c.Name == email))
                .FirstOrDefaultAsync();
        }

        if (existingChat != null)
        {
            // Backfill PartnerEmail on old chats that don't have it yet
            if (string.IsNullOrEmpty(existingChat.PartnerEmail) && !string.IsNullOrEmpty(email))
            {
                existingChat.PartnerEmail = email;
            }

            // Unarchive if it was archived
            if (existingChat.Archived)
            {
                existingChat.Archived = false;
                await DbContext.SaveChangesAsync();
                await LoadChatsAsync();
            }
            // Update public key if provided
            if (publicKey != null)
            {
                var c = await DbContext.Contacts.FindAsync(email);
                if (c != null && c.PublicKey != publicKey)
                {
                    c.PublicKey = publicKey;
                    await DbContext.SaveChangesAsync();
                }
            }
            CloseNewChat();
            if (PlatformService.IsDesktop)
                await SelectChat(existingChat.ChatId);
            else
                Navigation.NavigateTo($"/chat/{existingChat.ChatId}");
            return;
        }

        // Ensure contact exists / update verification and public key
        var contact = await DbContext.Contacts.FindAsync(email);
        if (contact == null)
        {
            contact = new Contact
            {
                Email = email,
                DisplayName = string.IsNullOrEmpty(displayName) ? email.Split('@')[0] : displayName,
                Verified = verified,
                PublicKey = publicKey
            };
            DbContext.Contacts.Add(contact);
        }
        else
        {
            if (verified && !contact.Verified)
                contact.Verified = true;
            if (!string.IsNullOrEmpty(displayName))
                contact.DisplayName = displayName;
            if (publicKey != null)
                contact.PublicKey = publicKey;
        }

        var chatName = contact.DisplayName ?? email.Split('@')[0];
        var chatId = Guid.NewGuid().ToString();
        var chat = new Chat
        {
            ChatId = chatId,
            Type = ChatType.OneToOne,
            Name = chatName,
            PartnerEmail = email,
            AccountId = activeAccountId,
            CreatedAt = DateTimeOffset.UtcNow,
            LastActivityAt = DateTimeOffset.UtcNow
        };
        DbContext.Chats.Add(chat);
        await DbContext.SaveChangesAsync();

        allContacts = await DbContext.Contacts.OrderBy(c => c.DisplayName).ToListAsync();
        await LoadChatsAsync();

        CloseNewChat();
        if (PlatformService.IsDesktop)
            await SelectChat(chatId);
        else
            Navigation.NavigateTo($"/chat/{chatId}");
    }

