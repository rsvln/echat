@page "/chats"
@using EChat.Core.Models
@using EChat.Core.Data
@using EChat.Core.Protocol
@using EChat.Core.Transport
@using EChat.Core.Sync
@using EChat.Core.Crypto
@using EChat.UI.Services
@using EChat.UI.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.DependencyInjection
@using Net.Codecrete.QrCodeGenerator
@inject ChatDbContext DbContext
@inject IServiceScopeFactory ScopeFactory
@inject NavigationManager Navigation
@inject EmailTransportService TransportService
@inject UserContextService UserContext
@inject IPlatformService PlatformService
@inject IAppPreferences Prefs
@inject IJSRuntime JS
@inject ChatEventService ChatEvents
@inject SyncEngine SyncEngine
@inject PgpService Pgp
@inject EChat.Core.Services.FileLogger FileLogger
@inject EChat.Core.ServiceCollectionExtensions.DatabasePathInfo DbPathInfo
@implements IDisposable

@if (PlatformService.IsDesktop)
{
    <!-- ══════════════════════════════════════
         Windows — three-column desktop layout
    ══════════════════════════════════════ -->
    <div class="desktop-layout">

        <!-- ─── Account column ─── -->
        <div class="account-column">
            @if (accounts != null)
            {
                @foreach (var acc in accounts)
                {
                    <div style="position:relative;display:inline-block;">
                        <button class="account-avatar-btn @(acc.AccountId == activeAccountId ? "active" : "")"
                                title="@acc.DisplayName (@acc.Email)@(IsAccountRateLimited(acc.AccountId) ? $" — SMTP rate-limited until {AccountRateLimitTime(acc.AccountId)}" : "")"
                                style="background-color: @(acc.AvatarColor ?? "#5BA642")"
                                @onclick="@(() => SwitchAccount(acc.AccountId))">
                            @acc.DisplayName.Substring(0, 1).ToUpper()
                        </button>
                        @if (IsAccountRateLimited(acc.AccountId))
                        {
                            <span title="SMTP rate-limited — sending paused until @(AccountRateLimitTime(acc.AccountId) ?? "soon")"
                                  style="position:absolute;bottom:-4px;right:-4px;background:#f59e0b;color:#fff;border-radius:999px;width:16px;height:16px;font-size:10px;font-weight:700;display:flex;align-items:center;justify-content:center;pointer-events:none;line-height:1;">
                                ⚠
                            </span>
                        }
                        else if (accountUnreadCounts.GetValueOrDefault(acc.AccountId) > 0 && acc.AccountId != activeAccountId)
                        {
                            <span style="position:absolute;top:-4px;right:-4px;background:#e53935;color:#fff;border-radius:999px;min-width:16px;height:16px;font-size:10px;font-weight:700;display:flex;align-items:center;justify-content:center;padding:0 3px;pointer-events:none;">
                                @accountUnreadCounts[acc.AccountId]
                            </span>
                        }
                    </div>
                }
            }
            <button class="account-add-btn" title="Add account"
                    @onclick="@(() => Navigation.NavigateTo("/setup"))">+</button>
            <div class="account-spacer"></div>
            <button class="account-global-btn" title="Contacts"
                    @onclick="@(() => showContacts = true)">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
            </button>
            <button class="account-settings-btn" title="Account settings"
                    @onclick="OpenAccountSettings">⚙</button>
            <button class="account-global-btn" title="App settings"
                    @onclick="@(() => Navigation.NavigateTo("/settings"))">☰</button>
            <button class="account-global-btn" title="About"
                    @onclick="@(() => Navigation.NavigateTo("/about"))">ⓘ</button>
        </div>

        <!-- ─── Chat list panel ─── -->
        <div class="left-panel">
            <div class="left-header">
                <span class="app-title">@(activeAccount?.DisplayName ?? "εChat")</span>
                <button class="icon-btn" title="New chat" @onclick="OpenNewChat">[+]</button>
            </div>

            <div class="search-bar">
                <div style="display:flex;flex-direction:row;align-items:center;gap:8px;width:100%;">
                    <span style="flex:0 0 26px;width:26px;height:26px;display:inline-flex;align-items:center;justify-content:center;border-radius:2px;font-size:12px;font-weight:700;cursor:pointer;user-select:none;border:1px solid @(showArchived ? "var(--primary)" : "rgba(0,0,0,0.22)");background:@(showArchived ? "var(--primary)" : "rgba(0,0,0,0.04)");color:@(showArchived ? "#fff" : "var(--text-secondary)");text-decoration:@(showArchived ? "none" : "line-through");"
                          title="@(showArchived ? "Hide archived" : "Show archived")"
                          @onclick="async () => { showArchived = !showArchived; await LoadChatsAsync(); }">A</span>
                    <input type="text"
                           class="search-input"
                           style="flex:1 1 0;min-width:0;"
                           placeholder="Search chats..."
                           @bind="searchQuery"
                           @bind:event="oninput" />
                </div>
            </div>

            <div class="chat-list">
                @if (chats == null)
                {
                    <div class="empty-state"><p>Loading...</p></div>
                }
                else if (!FilteredChats.Any())
                {
                    <div class="empty-state">
                        <div class="empty-state-icon">💬</div>
                        <p>@(string.IsNullOrEmpty(searchQuery) ? "No chats yet" : "No chats found")</p>
                    </div>
                }
                else
                {
                    @foreach (var chat in FilteredChats)
                    {
                        <div class="chat-item @(chat.ChatId == selectedChatId ? "active" : "") @(chat.Archived ? "chat-item-archived" : "")"
                             @onclick="@(() => SelectChat(chat.ChatId))"
                             @oncontextmenu="@(e => OpenChatCtxMenu(e, chat))"
                             @oncontextmenu:preventDefault="true">
                            <div class="chat-avatar @(chat.Type == ChatType.Group ? "chat-avatar-group" : "") @(GetAvatarColorClass(chat.Name))">
                                @chat.Name.Substring(0, 1).ToUpper()
                            </div>
                            <div class="chat-content">
                                <div class="chat-item-top">
                                    <span class="chat-name">
                                        <span class="chat-name-row">
                                            @if (chat.Type == ChatType.Group)
                                            {
                                                <svg class="chat-name-group-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <circle cx="12" cy="7" r="3.5"/>
                                                    <path d="M5.5 21v-2a5.5 5.5 0 0 1 5.5-5.5h2a5.5 5.5 0 0 1 5.5 5.5v2"/>
                                                    <circle cx="4" cy="9" r="2.5"/>
                                                    <path d="M1 21v-1.5a3.5 3.5 0 0 1 3-3.46"/>
                                                    <circle cx="20" cy="9" r="2.5"/>
                                                    <path d="M23 21v-1.5a3.5 3.5 0 0 0-3-3.46"/>
                                                </svg>
                                            }
                                            else if (encryptedContactEmails.Contains(chat.ChatId))
                                            {
                                                <svg class="chat-name-lock-icon" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" title="Encrypted">
                                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                                                </svg>
                                            }
                                            <span>@chat.Name</span>
                                        </span>
                                    </span>
                                    <span class="chat-time">@FormatTime(chat.LastActivityAt)</span>
                                </div>
                                <div class="chat-preview">
                                    @if (chat.Archived)
                                    {
                                        <a class="unarchive-link"
                                           href="javascript:void(0)"
                                           @onclick:stopPropagation="true"
                                           @onclick="@(() => ToggleArchiveFromMenu(chat.ChatId, false))">Unarchive</a>
                                    }
                                    else
                                    {
                                        var preview = GetLastMessagePreview(chat);
                                        <span class="preview-text">@(string.IsNullOrEmpty(preview) ? "···" : preview)</span>
                                        @if (chat.UnreadCount > 0)
                                        {
                                            <span class="chat-badge">@chat.UnreadCount</span>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- ─── Chat view panel ─── -->
        <div class="right-panel">
            @if (selectedChatId == null)
            {
                <div class="no-chat-selected">
                    <div class="no-chat-icon">💬</div>
                    <p>Select a chat to start messaging</p>
                </div>
            }
            else
            {
                <div class="chat-view-header">
                    <div class="chat-view-header-info">
                        <div class="chat-view-avatar @(selectedChat?.Type == ChatType.Group ? "chat-avatar-group" : "")">
                            @(selectedChat?.Name.Substring(0, 1).ToUpper())
                        </div>
                        <span class="chat-view-name">@selectedChat?.Name</span>
                    </div>
                    <button class="icon-btn icon-btn-dark" @onclick="ShowChatInfo" title="Chat info">ℹ</button>
                </div>

                <div class="messages-container" @ref="messagesContainer" @onclick="ClosePopups">
                    @if (messages == null)
                    {
                        <p class="loading">Loading messages...</p>
                    }
                    else if (!messages.Any())
                    {
                        <div class="messages-empty"><p>No messages yet. Say hello!</p></div>
                    }
                    else
                    {
                        @foreach (var message in messages)
                        {
                            var quotedMsg = message.InReplyTo != null
                                ? messagesById.GetValueOrDefault(message.InReplyTo)
                                : null;
                            var quotedSender = quotedMsg != null
                                ? contactNames.GetValueOrDefault(quotedMsg.Sender, quotedMsg.Sender.Split('@')[0])
                                : null;
                            _messageAttachments.TryGetValue(message.MessageId, out var atts);
                            _messageReactions.TryGetValue(message.MessageId, out var reacts);
                            <MessageBubble Message="@message"
                                           IsOwn="@IsOwnMessage(message)"
                                           SenderDisplayName="@(contactNames.GetValueOrDefault(message.Sender, message.Sender.Split('@')[0]))"
                                           QuotedMessage="@quotedMsg"
                                           QuotedSenderName="@quotedSender"
                                           Attachments="@(atts ?? new List<Attachment>())"
                                            Reactions="@(reacts ?? new List<MessageReaction>())"
                                            UserEmail="@UserContext.UserEmail"
                                            OnReply="@StartReply"
                                           OnEdit="@StartEdit"
                                           OnDeleteForMe="@DeleteMessageForMe"
                                           OnDeleteForAll="@DeleteMessageForAll"
                                           OnForward="@StartForward"
                                           OnScrollToQuoted="@ScrollToMessage"
                                           OnReact="@HandleReaction" />
                        }
                    }
                </div>

                @if (!string.IsNullOrEmpty(sendError))
                {
                    <div class="send-error">@sendError</div>
                }

                @* ── Reply / Edit strip ──────────────────────────────── *@
                @if (replyingToMessage != null)
                {
                    <div style="display:flex;align-items:center;gap:8px;padding:6px 12px;
                                background:rgba(91,166,66,.08);border-top:1px solid rgba(91,166,66,.3);">
                        <div style="flex:1;border-left:3px solid var(--primary,#5BA642);padding-left:8px;font-size:12px;">
                            <div style="font-weight:600;color:var(--primary,#5BA642);">
                                @(contactNames.GetValueOrDefault(replyingToMessage.Sender, replyingToMessage.Sender.Split('@')[0]))
                            </div>
                            <div style="color:#555;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:400px;">
                                @FormatContentWithLinks(replyingToMessage.Content.Length > 60 ? replyingToMessage.Content[..60] + "…" : replyingToMessage.Content)
                            </div>
                        </div>
                        <button style="background:none;border:none;cursor:pointer;font-size:16px;color:#888;"
                                @onclick="CancelReply">✕</button>
                    </div>
                }
                @if (editingMessage != null)
                {
                    <div style="display:flex;align-items:center;gap:8px;padding:6px 12px;
                                background:rgba(255,165,0,.08);border-top:1px solid rgba(255,165,0,.3);">
                        <div style="flex:1;font-size:12px;color:#888;">✏ Editing message</div>
                        <button style="background:none;border:none;cursor:pointer;font-size:16px;color:#888;"
                                @onclick="CancelEdit">✕</button>
                    </div>
                }

                <div class="message-input-bar">
                    <div class="attach-wrap">
                        <button class="input-btn" @onclick="ShowAttachMenu" @onclick:stopPropagation title="Attach">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 01-8.49-8.49l9.19-9.19a4 4 0 015.66 5.66l-9.2 9.19a2 2 0 01-2.83-2.83l8.49-8.48"/></svg>
                        </button>
                        @if (showAttachMenu)
                        {
                            <div class="attach-menu-popup" @onclick:stopPropagation>
                                <button class="attach-option" @onclick="SelectPhoto">
                                    <svg class="attach-svg-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                                    <span>Photo</span>
                                </button>
                                <button class="attach-option" @onclick="SelectFile">
                                    <svg class="attach-svg-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                                    <span>File</span>
                                </button>
                            </div>
                        }
                    </div>
                    <textarea class="message-textarea"
                              id="messageInput"
                              placeholder="@(editingMessage != null ? "Edit message…" : "Write a message...")"
                              @oninput="OnMessageTextInput"
                              @onkeydown="OnMessageKeyDown"
                              @onfocus="ClosePopups"
                              @oncontextmenu="OnTextareaContextMenu"
                              @oncontextmenu:preventDefault="true"
                              rows="1"></textarea>
                    <button class="input-btn" @onclick="ToggleEmojiPicker" title="Emoji">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
                    </button>
                    <button class="send-btn @(string.IsNullOrWhiteSpace(messageText) && pendingAttachments.Count == 0 ? "send-btn-disabled" : "")"
                            @onclick="SendMessage"
                            disabled="@(string.IsNullOrWhiteSpace(messageText) && pendingAttachments.Count == 0)">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
                    </button>
                </div>

                @* Attachment previews *@
                @if (pendingAttachments.Count > 0)
                {
                    <div class="attachment-previews">
                        @foreach (var att in pendingAttachments)
                        {
                            <div class="attachment-preview-item">
                                @if (att.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
                                {
                                    <img class="attachment-preview-img" src="@att.DataUrl" alt="@att.FileName" />
                                }
                                else
                                {
                                    <div class="attachment-preview-file">
                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                                        <span>@att.FileName</span>
                                    </div>
                                }
                                <input class="attachment-caption"
                                       placeholder="Add a caption..."
                                       value="@att.Caption"
                                       @oninput="@(e => att.Caption = e.Value?.ToString() ?? "")" />
                                <button class="attachment-remove" @onclick="@(() => pendingAttachments.Remove(att))">✕</button>
                            </div>
                        }
                    </div>
                }

                @* Hidden file inputs *@
                <InputFile id="photoInput" accept="image/*" multiple style="display:none" OnChange="OnPhotoSelected" />
                <InputFile id="fileInput" multiple style="display:none" OnChange="OnFileSelected" />

                @if (showEmojiPicker)
                {
                    <div class="emoji-picker-popup" @onclick:stopPropagation>
                        <div class="emoji-picker-header">
                            <span>Emoji</span>
                            <button class="emoji-close" @onclick="() => showEmojiPicker = false">✕</button>
                        </div>
                        <div class="emoji-grid">
                            @foreach (var emoji in emojiList)
                            {
                                <button class="emoji-btn" @onclick="@(() => InsertEmoji(emoji))">@emoji</button>
                            }
                        </div>
                    </div>
                }

                @if (showFormatMenu)
                {
                    <div class="format-menu" style="left:@(formatMenuX)px;top:@(formatMenuY)px;">
                        <button class="format-menu-btn" @onclick='@(() => InsertFormat("**", "**"))' title="Bold"><strong>B</strong></button>
                        <button class="format-menu-btn" @onclick='@(() => InsertFormat("*", "*"))' title="Italic"><em>I</em></button>
                        <button class="format-menu-btn" @onclick='@(() => InsertFormat("~~", "~~"))' title="Strikethrough"><del>S</del></button>
                        <button class="format-menu-btn" @onclick='@(() => InsertFormat("--", "--"))' title="Underline"><u>U</u></button>
                        <button class="format-menu-btn" @onclick='@(() => InsertFormat("`", "`"))' title="Inline Code"><code>&lt;/&gt;</code></button>
                        <button class="format-menu-btn" @onclick='@(() => InsertFormat("```\n", "\n```"))' title="Code Block"><span style="font-size:9px;">{ }</span></button>
                        <button class="format-menu-btn" @onclick='@(() => InsertFormat("||", "||"))' title="Spoiler"><span style="background:black;color:white;padding:0 2px;font-size:10px;">S</span></button>
                        <button class="format-menu-btn" @onclick='@(() => InsertFormat("> ", ""))' title="Quote"><span style="font-size:14px;">&gt;</span></button>
                    </div>
                }


                @if (false)
                {
                    <div class="attach-menu-popup">
                        <button class="attach-option">
                            <span>Photo</span>
                        </button>
                        <button class="attach-option">
                            <span>File</span>
                        </button>
                    </div>
                }
            }
        </div>

    </div>

    <ChatInfoModal IsVisible="@showChatInfo"
                   ChatId="@selectedChatId"
                   ActiveAccountId="@activeAccountId"
                   OnClose="@(() => showChatInfo = false)"
                   OnChatArchived="@OnChatArchived"
                   OnChatUnarchived="@OnChatUnarchived"
                   OnChatDeleted="@DeleteChatRemote"
                   OnGroupLeft="@LeaveGroupRemote" />

    @* ── Chat list context menu ───────────────────────────────────── *@
    @if (_showChatCtx && _chatCtxChat != null)
    {
        <div style="position:fixed;inset:0;z-index:998;" @onclick="CloseChatCtx"></div>
        <div class="ctx-menu" style="left:@(_chatCtxX)px;top:@(_chatCtxY)px;z-index:999;">
            <div class="ctx-item" @onclick="ToggleMutedCtx" @onclick:stopPropagation="true">
                @if (_chatCtxChat.Muted)
                {
                    <svg class="ctx-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>
                    <span>Unmute</span>
                }
                else
                {
                    <svg class="ctx-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/></svg>
                    <span>Mute</span>
                }
            </div>
            @if (_chatCtxChat.Archived)
            {
                <div class="ctx-item" @onclick="ToggleArchiveCtx" @onclick:stopPropagation="true">
                    <svg class="ctx-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="21 8 21 21 3 21 3 8"/><rect x="1" y="3" width="22" height="5"/><line x1="10" y1="12" x2="14" y2="12"/></svg>
                    <span>Unarchive</span>
                </div>
            }
            else
            {
                <div class="ctx-item" @onclick="ToggleArchiveCtx" @onclick:stopPropagation="true">
                    <svg class="ctx-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="21 8 21 21 3 21 3 8"/><rect x="1" y="3" width="22" height="5"/><line x1="10" y1="12" x2="14" y2="12"/></svg>
                    <span>Archive</span>
                </div>
            }
            <div class="ctx-divider"></div>
            <div class="ctx-item ctx-danger" @onclick="@(() => _chatCtxConfirmDelete = true)" @onclick:stopPropagation="true">
                <svg class="ctx-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                <span>Delete</span>
            </div>
        </div>
    }

    @* ── Delete confirmation ──────────────────────────────────────── *@
    @if (_chatCtxConfirmDelete && _chatCtxChat != null)
    {
        <div class="nc-overlay" @onclick="CloseChatCtx">
            <div class="new-chat-modal" style="max-width:340px;" @onclick:stopPropagation="true">
                <div class="new-chat-modal-header">
                    <span style="font-weight:600;font-size:15px;flex:1;">Delete chat</span>
                    <button class="new-chat-close" @onclick="CloseChatCtx">✕</button>
                </div>
                <div style="padding:16px;">
                    @if (_chatCtxChat.Type == ChatType.Group)
                    {
                        <p style="margin:0 0 16px;font-size:14px;">Are you an admin of this group?</p>
                        <div style="display:flex;flex-direction:column;gap:8px;">
                            <button class="new-chat-btn-danger" @onclick="CtxDeleteGroupAsAdmin">Delete group for everyone</button>
                            <button class="new-chat-btn-secondary" @onclick="CtxLeaveGroup">Leave group</button>
                            <button class="new-chat-btn-cancel" @onclick="CloseChatCtx">Cancel</button>
                        </div>
                    }
                    else
                    {
                        <p style="margin:0 0 16px;font-size:14px;">Delete this chat and notify the other participant?</p>
                        <div style="display:flex;flex-direction:column;gap:8px;">
                            <button class="new-chat-btn-danger" @onclick="CtxDeleteOneToOne">Delete chat</button>
                            <button class="new-chat-btn-cancel" @onclick="CloseChatCtx">Cancel</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

}
else
{
    <!-- ══════════════════════════════════════
         Android / iOS — mobile layout
    ══════════════════════════════════════ -->
    <div class="app-container">
        <!-- ── Mobile account switcher dropdown ── -->
        @if (showMobileAccountMenu)
        {
            <div class="mob-acc-overlay" @onclick="@(() => showMobileAccountMenu = false)">
                <div class="mob-acc-dropdown" @onclick:stopPropagation>
                    @if (accounts != null)
                    {
                        @foreach (var acc in accounts)
                        {
                            <div class="mob-acc-item @(acc.AccountId == activeAccountId ? "active" : "")"
                                 @onclick="@(async () => { showMobileAccountMenu = false; await SwitchAccount(acc.AccountId); })">
                                <div style="position:relative;display:inline-block;flex-shrink:0;">
                                    <div class="mob-acc-avatar" style="background:@(acc.AvatarColor ?? "#5b8fd9")">
                                        @(acc.DisplayName.Length > 0 ? acc.DisplayName.Substring(0, 1).ToUpper() : "?")
                                    </div>
                                    @if (IsAccountRateLimited(acc.AccountId))
                                    {
                                        <span title="SMTP rate-limited until @(AccountRateLimitTime(acc.AccountId))"
                                              style="position:absolute;bottom:-3px;right:-3px;background:#f59e0b;color:#fff;border-radius:999px;width:14px;height:14px;font-size:9px;display:flex;align-items:center;justify-content:center;pointer-events:none;">
                                            ⚠
                                        </span>
                                    }
                                </div>
                                <div class="mob-acc-info">
                                    <div class="mob-acc-name">@acc.DisplayName@(IsAccountRateLimited(acc.AccountId) ? " ⚠" : "")</div>
                                    <div class="mob-acc-email">@acc.Email</div>
                                </div>
                                @if (acc.AccountId == activeAccountId)
                                {
                                    <svg class="mob-acc-check" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                                }
                            </div>
                        }
                    }
                    <div class="mob-acc-item" @onclick="@(() => { showMobileAccountMenu = false; Navigation.NavigateTo("/setup"); })">
                        <div class="mob-acc-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                        </div>
                        <div class="mob-acc-info">
                            <div class="mob-acc-name">Add Account</div>
                        </div>
                    </div>
                    <div class="mob-acc-divider"></div>
                    <div class="mob-acc-item" @onclick="@(() => { showMobileAccountMenu = false; showContacts = true; })">
                        <div class="mob-acc-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        </div>
                        <div class="mob-acc-info">
                            <div class="mob-acc-name">Contacts</div>
                        </div>
                    </div>
                    <div class="mob-acc-item" @onclick="@(() => { showMobileAccountMenu = false; OpenAccountSettings(); })">
                        <div class="mob-acc-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
                        </div>
                        <div class="mob-acc-info">
                            <div class="mob-acc-name">Account Settings</div>
                        </div>
                    </div>
<div class="mob-acc-item" @onclick="@(() => { showMobileAccountMenu = false; Navigation.NavigateTo("/settings"); })">
                            <div class="mob-acc-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                            </div>
                            <div class="mob-acc-info">
                                <div class="mob-acc-name">App Settings</div>
                            </div>
                        </div>
                        <div class="mob-acc-item" @onclick="@(() => { showMobileAccountMenu = false; Navigation.NavigateTo("/about"); })">
                            <div class="mob-acc-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                            </div>
                            <div class="mob-acc-info">
                                <div class="mob-acc-name">About</div>
                            </div>
                        </div>

                </div>
            </div>
        }

        <div class="app-header">
            <button class="mob-acc-trigger" @onclick="@(() => showMobileAccountMenu = !showMobileAccountMenu)">
                @if (activeAccount != null)
                {
                    <div style="position:relative;display:inline-block;">
                        <div class="mob-acc-trigger-avatar" style="background:@(activeAccount.AvatarColor ?? "#5b8fd9")">
                            @(activeAccount.DisplayName.Length > 0 ? activeAccount.DisplayName.Substring(0, 1).ToUpper() : "?")
                        </div>
                        @if (IsAccountRateLimited(activeAccount.AccountId))
                        {
                            <span title="SMTP rate-limited"
                                  style="position:absolute;bottom:-3px;right:-3px;background:#f59e0b;color:#fff;border-radius:999px;width:14px;height:14px;font-size:9px;display:flex;align-items:center;justify-content:center;pointer-events:none;">
                                ⚠
                            </span>
                        }
                    </div>
                    <span class="mob-acc-trigger-name">@activeAccount.DisplayName@(IsAccountRateLimited(activeAccount.AccountId) ? " ⚠" : "")</span>
                }
                else
                {
                    <span class="mob-acc-trigger-name">εChat</span>
                }
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                     style="transition:transform 0.2s; transform:rotate(@(showMobileAccountMenu ? "180deg" : "0deg"))">
                    <polyline points="6 9 12 15 18 9"/>
                </svg>
            </button>
            <div class="app-header-actions">
                <button class="header-icon" @onclick="OpenNewChat" title="New chat">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7"/><path d="M18.37 2.63a2 2 0 0 1 2.83 2.83L12 14.5l-4 1 1-4Z"/></svg>
                </button>
            </div>
        </div>

        <div class="search-bar">
            <input type="text"
                   class="search-input"
                   placeholder="Search chats..."
                   @bind="searchQuery"
                   @bind:event="oninput" />
        </div>

        <div class="chat-list">
            @if (chats == null)
            {
                <div class="empty-state">
                    <div class="empty-state-icon">💬</div>
                    <p>Loading chats...</p>
                </div>
            }
            else if (!FilteredChats.Any())
            {
                <div class="empty-state">
                    <div class="empty-state-icon">💬</div>
                    <p>@(string.IsNullOrEmpty(searchQuery) ? "No chats yet" : "No chats found")</p>
                </div>
            }
            else
            {
                @foreach (var chat in FilteredChats)
                {
                    <div class="chat-item" @onclick="@(() => Navigation.NavigateTo($"/chat/{chat.ChatId}"))">
                            <div class="chat-avatar @(chat.Type == ChatType.Group ? "chat-avatar-group" : "") @(GetAvatarColorClass(chat.Name))">
                                @chat.Name.Substring(0, 1).ToUpper()
                            </div>
                        <div class="chat-content">
                            <div class="chat-item-top">
                                <span class="chat-name">
                                    <span class="chat-name-row">
                                        @if (chat.Type == ChatType.Group)
                                        {
                                            <svg class="chat-name-group-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                                <circle cx="9" cy="7" r="4"/>
                                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                                                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                                            </svg>
                                        }
                                        else if (encryptedContactEmails.Contains(chat.ChatId))
                                        {
                                            <svg class="chat-name-lock-icon" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" title="Encrypted">
                                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                                                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                                            </svg>
                                        }
                                        <span>@chat.Name</span>
                                    </span>
                                </span>
                                <span class="chat-time">@FormatTime(chat.LastActivityAt)</span>
                            </div>
                            <div class="chat-preview">
                                @{
                                    var preview = GetLastMessagePreview(chat);
                                }
                                <span class="preview-text">@(string.IsNullOrEmpty(preview) ? "···" : preview)</span>
                                @if (chat.UnreadCount > 0)
                                {
                                    <span class="chat-badge">@chat.UnreadCount</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
}

<!-- ══════════════════════════════════════
     Forward message dialog
══════════════════════════════════════ -->
@if (showForwardDialog && forwardingMessage != null)
{
    <div class="nc-overlay" @onclick="@(() => showForwardDialog = false)">
        <div class="new-chat-modal" style="max-height:70vh;display:flex;flex-direction:column;" @onclick:stopPropagation>
            <div class="new-chat-modal-header">
                <span style="font-weight:600;font-size:15px;flex:1;">Forward to...</span>
                <button class="new-chat-close" @onclick="@(() => showForwardDialog = false)">✕</button>
            </div>
            <div style="overflow-y:auto;flex:1;padding:4px 0;">
                @if (chats != null)
                {
                    @foreach (var chat in chats.Where(c => c.ChatId != selectedChatId))
                    {
                        <div class="chat-item" @onclick="@(() => ForwardToChat(chat))" @onclick:stopPropagation>
                            <div class="chat-avatar @(chat.Type == ChatType.Group ? "chat-avatar-group" : "") @(GetAvatarColorClass(chat.Name))">
                                @chat.Name.Substring(0, 1).ToUpper()
                            </div>
                            <div class="chat-content">
                                <div class="chat-item-top">
                                    <span class="chat-name">@chat.Name</span>
                                    <span class="chat-time">@FormatTime(chat.LastActivityAt)</span>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}

<NewChatModal IsVisible="@showNewChat"
             ActiveAccount="@activeAccount"
             ActiveAccountId="@activeAccountId"
             OnClose="@CloseNewChat"
             OnChatReady="@OnNewChatReady" />

<ContactsModal IsVisible="@showContacts"
               ActiveAccountId="@activeAccountId"
               OnClose="@(() => showContacts = false)"
               OnOpenChat="@OnNewChatReady" />

