@page "/chat/{ChatId}"
@using EChat.Core.Models
@using EChat.Core.Data
@using EChat.Core.Protocol
@using EChat.Core.Transport
@using EChat.Core.Sync
@using EChat.UI.Services
@using EChat.UI.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.DependencyInjection
@inject IServiceScopeFactory ScopeFactory
@inject ChatDbContext DbContext
@inject NavigationManager Navigation
@inject EmailTransportService TransportService
@inject UserContextService UserContext
@inject IJSRuntime JS
@inject IAppPreferences Prefs
@inject ChatEventService ChatEvents
@inject EChat.Core.Services.FileLogger FileLogger
@inject EChat.Core.ServiceCollectionExtensions.DatabasePathInfo DbPathInfo
@inject IPlatformService PlatformService
@implements IDisposable

<div class="mobile-chat-view">
    @if (selectedChat != null)
    {
        <div class="mobile-chat-header">
            @if (_selectedMessage != null)
            {
                <button class="mobile-back-btn" @onclick="ClearSelection">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
                <div style="flex:1"></div>
                @if (IsOwnMessage(_selectedMessage))
                {
                    <button class="mobile-info-btn" @onclick="EditSelected" title="Edit">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                    </button>
                }
                <button class="mobile-info-btn" @onclick="ReplySelected" title="Reply">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 17 4 12 9 7"/><path d="M20 18v-2a4 4 0 0 0-4-4H4"/></svg>
                </button>
                <button class="mobile-info-btn" @onclick="CopySelected" title="Copy">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                </button>
                <button class="mobile-info-btn" @onclick="ForwardSelected" title="Forward">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 17 20 12 15 7"/><path d="M4 18v-2a4 4 0 0 1 4-4h12"/></svg>
                </button>
                @if (SelectedFileAttachments.Any())
                {
                    <button class="mobile-info-btn" @onclick="OpenSelectedAtt" title="Open file">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                    </button>
                    <button class="mobile-info-btn" @onclick="SaveSelectedAtt" title="Save to Downloads">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    </button>
                }
                <button class="mobile-info-btn" @onclick="DeleteSelected" title="Delete" style="color:#e53935;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                </button>
            }
            else
            {
                <button class="mobile-back-btn" @onclick="GoBack">←</button>
                <div class="mobile-chat-header-info" @onclick="ShowChatInfo">
                    <div class="mobile-chat-name">@selectedChat.Name</div>
                </div>
                <button class="mobile-info-btn" @onclick="ShowChatInfo" title="Chat info">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                </button>
            }
        </div>

        <div class="mobile-messages-container" @ref="messagesContainer" @onclick="ClearSelection">
            @if (messages != null && messages.Count > 0)
            {
                @foreach (var message in messages)
                {
                    var quotedMsg = message.InReplyTo != null
                        ? messagesById.GetValueOrDefault(message.InReplyTo)
                        : null;
                    var quotedSender = quotedMsg != null
                        ? contactNames.GetValueOrDefault(quotedMsg.Sender, quotedMsg.Sender.Split('@')[0])
                        : null;
                    _messageAttachments.TryGetValue(message.MessageId, out var atts);
                    _messageReactions.TryGetValue(message.MessageId, out var reacts);
                    <MessageBubble Message="@message"
                                   IsOwn="@IsOwnMessage(message)"
                                   SenderDisplayName="@(contactNames.GetValueOrDefault(message.Sender, message.Sender.Split('@')[0]))"
                                   SenderColor="@(memberColors.GetValueOrDefault(message.Sender))"
                                   QuotedMessage="@quotedMsg"
                                   QuotedSenderName="@quotedSender"
                                   Attachments="@(atts ?? new List<Attachment>())"
                                   Reactions="@(reacts ?? new List<MessageReaction>())"
                                   UserEmail="@UserContext.UserEmail"
                                   OnReply="@StartReply"
                                   OnEdit="@StartEdit"
                                   OnDeleteForMe="@DeleteMessageForMe"
                                   OnDeleteForAll="@DeleteMessageForAll"
                                   OnForward="@StartForward"
                                   OnScrollToQuoted="@ScrollToMessage"
                                   OnReact="@HandleReaction"
                                   MobileMode="true"
                                   IsSelected="@(_selectedMessage?.MessageId == message.MessageId)"
                                   OnSelected="@SelectMessage" />
                }
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-state-icon">💬</div>
                    <div>No messages yet</div>
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(sendError))
        {
            <div class="mob-reply-strip send-error">@sendError</div>
        }

        @if (replyingToMessage != null)
        {
            <div class="mob-reply-strip" style="background:rgba(91,166,66,.08);border-top:1px solid rgba(91,166,66,.3);">
                <div style="flex:1;border-left:3px solid var(--primary,#5BA642);padding-left:8px;font-size:12px;">
                    <div style="font-weight:600;color:var(--primary,#5BA642);">
                        @(contactNames.GetValueOrDefault(replyingToMessage.Sender, replyingToMessage.Sender.Split('@')[0]))
                    </div>
                    <div style="color:#555;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:400px;">
                        @FormatContentWithLinks(replyingToMessage.Content.Length > 60 ? replyingToMessage.Content[..60] + "…" : replyingToMessage.Content)
                    </div>
                </div>
                <button style="background:none;border:none;cursor:pointer;font-size:16px;color:#888;"
                        @onclick="CancelReply">✕</button>
            </div>
        }

        @if (editingMessage != null)
        {
            <div class="mob-reply-strip" style="background:rgba(255,193,7,.08);border-top:1px solid rgba(255,193,7,.3);">
                <div style="flex:1;border-left:3px solid #ffc107;padding-left:8px;font-size:12px;">
                    <div style="font-weight:600;color:#ffc107;">Editing message</div>
                    <div style="color:#555;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:400px;">
                        @FormatContentWithLinks(editingMessage.Content.Length > 60 ? editingMessage.Content[..60] + "…" : editingMessage.Content)
                    </div>
                </div>
                <button style="background:none;border:none;cursor:pointer;font-size:16px;color:#888;"
                        @onclick="CancelEdit">✕</button>
            </div>
        }

        @if (pendingAttachments.Count > 0)
        {
            <div class="attachment-previews">
                @foreach (var att in pendingAttachments)
                {
                    <div class="attachment-preview-item">
                        @if (att.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
                        {
                            <img class="attachment-preview-img" src="@att.DataUrl" alt="@att.FileName" />
                        }
                        else
                        {
                            <div class="attachment-preview-file">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                                <span>@att.FileName</span>
                            </div>
                        }
                        <input class="attachment-caption"
                               placeholder="Add a caption..."
                               value="@att.Caption"
                               @oninput="@(e => att.Caption = e.Value?.ToString() ?? "")" />
                        <button class="attachment-remove" @onclick="@(() => pendingAttachments.Remove(att))">✕</button>
                    </div>
                }
            </div>
        }

        @if (_selectedMessage != null)
        {
            <div class="mob-reaction-strip" @onclick:stopPropagation>
                @foreach (var emoji in _quickReactions)
                {
                    var msg = _selectedMessage;
                    var isActive = _messageReactions.TryGetValue(msg.MessageId, out var reacts) && reacts.Any(r => r.Emoji == emoji && r.Sender == UserContext.UserEmail);
                    <button class="ctx-reaction-btn @(isActive ? "active" : "")"
                            @onclick="@(async () => { await HandleReaction((emoji, msg)); ClearSelection(); })">@emoji</button>
                }
            </div>
        }

        <div class="message-input-bar">
            <div class="attach-wrap">
                <button class="input-btn" @onclick="ShowAttachMenu" @onclick:stopPropagation title="Attach">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 01-8.49-8.49l9.19-9.19a4 4 0 015.66 5.66l-9.2 9.19a2 2 0 01-2.83-2.83l8.49-8.48"/></svg>
                </button>
                @if (showAttachMenu)
                {
                    <div class="attach-menu-popup" @onclick:stopPropagation>
                        <button class="attach-option" @onclick="SelectPhoto">
                            <svg class="attach-svg-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                            <span>Photo</span>
                        </button>
                        <button class="attach-option" @onclick="SelectFile">
                            <svg class="attach-svg-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                            <span>File</span>
                        </button>
                    </div>
                }
            </div>

            <textarea class="message-textarea"
                      id="messageInput"
                      placeholder="@(editingMessage != null ? "Edit message…" : "Write a message...")"
                      @oninput="OnMessageTextInput"
                      @onkeydown="OnMessageKeyDown"
                      @onfocus="ClosePopups"
                      @oncontextmenu="OnTextareaContextMenu"
                      @oncontextmenu:preventDefault="true"
                      rows="1"></textarea>
            <button class="input-btn" @onclick="ToggleEmojiPicker" title="Emoji">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
            </button>
            <button class="send-btn @(string.IsNullOrWhiteSpace(messageText) && pendingAttachments.Count == 0 ? "send-btn-disabled" : "")"
                    @onclick="SendMessage"
                    disabled="@(string.IsNullOrWhiteSpace(messageText) && pendingAttachments.Count == 0)">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
            </button>
        </div>

        <InputFile id="photoInput" accept="image/*" multiple style="display:none" OnChange="OnPhotoSelected" />
        <InputFile id="fileInput" multiple style="display:none" OnChange="OnFileSelected" />

        @if (showEmojiPicker)
        {
            <div class="emoji-picker-popup" @onclick:stopPropagation>
                <div class="emoji-picker-header">
                    <span>Emoji</span>
                    <button class="emoji-close" @onclick="() => showEmojiPicker = false">✕</button>
                </div>
                <div class="emoji-grid">
                    @foreach (var emoji in emojiList)
                    {
                        <button class="emoji-btn" @onclick="@(() => InsertEmoji(emoji))">@emoji</button>
                    }
                </div>
            </div>
        }

        @if (showFormatMenu)
        {
            <div class="format-menu" style="left:@(formatMenuX)px;top:@(formatMenuY)px;">
                <button class="format-menu-btn" @onclick="InsertBold" title="Bold (жирный)"><strong>B</strong></button>
                <button class="format-menu-btn" @onclick="InsertItalic" title="Italic (курсив)"><em>I</em></button>
                <button class="format-menu-btn" @onclick="InsertStrikethrough" title="Strikethrough (зачеркнутый)"><del>S</del></button>
                <button class="format-menu-btn" @onclick="InsertUnderline" title="Underline (подчеркнутый)"><u>U</u></button>
                <button class="format-menu-btn" @onclick="InsertInlineCode" title="Inline Code (код)"><code>&lt;/&gt;</code></button>
                <button class="format-menu-btn" @onclick="OpenCodeEditor" title="Code Block (блок кода)"><span style="font-size:9px;">{ }</span></button>
                <button class="format-menu-btn" @onclick="InsertSpoiler" title="Spoiler (скрытый)"><span style="background:black;color:white;padding:0 2px;font-size:10px;">S</span></button>
            </div>
        }

        @if (showCodeEditor)
        {
            <div class="modal-overlay visible" @onclick="() => showCodeEditor = false">
                <div class="modal-content code-editor-modal">
                    <div class="modal-header">
                        <h2>Insert Code Block</h2>
                        <button class="close-btn" @onclick="() => showCodeEditor = false">✕</button>
                    </div>
                    <div class="modal-body">
                        <select @bind="selectedLanguage" class="code-lang-select">
                            <option value="">Plain Text</option>
                            <option value="csharp">C#</option>
                            <option value="javascript">JavaScript</option>
                            <option value="python">Python</option>
                            <option value="java">Java</option>
                            <option value="html">HTML</option>
                            <option value="css">CSS</option>
                            <option value="sql">SQL</option>
                            <option value="json">JSON</option>
                        </select>
                        <textarea @bind="codeEditorText" class="code-editor-textarea" placeholder="Enter your code here..."></textarea>
                    </div>
                    <div class="modal-footer">
                        <button class="btn-secondary" @onclick="() => showCodeEditor = false">Cancel</button>
                        <button class="btn-primary" @onclick="InsertCodeBlock">Insert</button>
                    </div>
                </div>
            </div>
        }

        @if (showForwardDialog)
        {
            <div class="modal-overlay visible" @onclick="() => showForwardDialog = false">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2>Forward to</h2>
                        <button class="close-btn" @onclick="() => showForwardDialog = false">✕</button>
                    </div>
                    <div class="modal-body">
                        @foreach (var c in chats?.Where(x => x.ChatId != forwardingMessage?.ChatId).OrderByDescending(x => x.LastActivityAt) ?? Enumerable.Empty<Chat>())
                        {
                            <div class="new-chat-contact-item" @onclick="@(() => ForwardToChat(c))">
                                <div class="chat-avatar @(c.Type == ChatType.Group ? "chat-avatar-group" : "") @(GetAvatarColorClass(c.Name))">
                                    @c.Name.Substring(0, 1).ToUpper()
                                </div>
                                <div class="chat-name">@c.Name</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>

<ChatInfoModal IsVisible="@showChatInfo"
               ChatId="@ChatId"
               OnClose="@(() => showChatInfo = false)"
               OnChatArchived="@OnChatArchived"
               OnChatUnarchived="@OnChatUnarchived"
               OnChatDeleted="@DeleteChatRemote"
               OnGroupLeft="@LeaveGroupRemote" />

@code {
    [Parameter] public string ChatId { get; set; } = string.Empty;

    private Chat? selectedChat;
    private List<ChatMessage>? messages;
    private List<string>? recipients;
    private string messageText = string.Empty;
    private bool _suppressTextareaRender;

    protected override bool ShouldRender()
    {
        if (_suppressTextareaRender)
        {
            _suppressTextareaRender = false;
            return false;
        }
        return true;
    }
    private ElementReference messagesContainer;
    private bool showChatInfo = false;
    private readonly HashSet<string> _sentReceiptIds = new(StringComparer.OrdinalIgnoreCase);
    private bool _scrollToBottom = false;
    private bool _wasNearBottom = true;
    private Dictionary<string, List<Attachment>> _messageAttachments = new();
    private Dictionary<string, List<MessageReaction>> _messageReactions = new();
    private List<PendingAttachment> pendingAttachments = new();
    private bool _fileSelecting;
    private Dictionary<string, ChatMessage> messagesById = new(StringComparer.OrdinalIgnoreCase);
    private ChatMessage? replyingToMessage;
    private ChatMessage? editingMessage;
    private ChatMessage? forwardingMessage;
    private bool showForwardDialog;
    private bool sendOnEnter = true;
    private bool showEmojiPicker = false;
    private bool showAttachMenu = false;
    private string sendError = string.Empty;
    private ChatMessage? _selectedMessage;
    private readonly string[] _quickReactions = ["👍", "❤️", "😂", "😮", "😢", "🔥", "👎", "😡", "🤮", "💩", "🤔", "😍", "🎉", "💯", "👀", "🙏", "🤡", "🤷"];
    private List<Chat>? chats;
    private Dictionary<string, string> contactNames = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, string> memberColors = new(StringComparer.OrdinalIgnoreCase);
    private List<Contact> allContacts = new();

    private readonly string[] emojiList = new[] {
        "😀","😃","😄","😁","😅","😂","🤣","😊","😇","🥰","😍","🤩","😘","😗","😚","😙",
        "🥲","😋","😛","😜","🤪","😝","🤑","🤗","🤭","🤫","🤔","🫡","🤐","🤨","😐","😑",
        "😶","🫥","😏","😒","🙄","😬","🤥","😌","😔","😪","🤤","😴","😷","🤒","🤕","🤢",
        "🤮","🥵","🥶","🥴","😵","🤯","🤠","🥳","🥸","😎","🤓","🧐","😕","🫤","😟","🙁",
        "😮","😯","😲","😳","🥺","🥹","😦","😧","😨","😰","😥","😢","😭","😱","😖","😣",
        "😞","😓","😩","😫","🥱","😤","😡","😠","🤬","😈","👿","💀","☠️","💩","🤡","👹",
        "👺","👻","👽","👾","🤖","😺","😸","😹","😻","😼","😽","🙀","😿","😾","🙈","🙉",
        "🙊","💋","💌","💘","💝","💖","💗","💓","💞","💕","💟","❣️","💔","❤️‍🔥","❤️‍🩹",
        "❤️","🧡","💛","💚","💙","💜","🤎","🖤","🤍","💯","💢","💥","💫","💦","💨","🕳️",
        "👍","👎","👊","✊","🤛","🤜","👏","🙌","🫶","👐","🤲","🤝","🙏","✌️","🤞","🫰",
        "🤟","🤘","👌","🤌","🤏","👈","👉","👆","👇","☝️","✋","🤚","🖐️","🖖","🫱","🫲",
        "🫳","🫴","👋","🤙","💪","🦾","🖕","✍️","🎉","🎊","🎈","🎁","🎀","🎗️","🏆","🥇",
        "🥈","🥉","⚽","🏀","🏈","⚾","🥎","🎾","🏐","🏉","🥏","🎱","🪀","🏓","🏸","🏒",
        "🔥","⭐","🌟","✨","💫","🌈","☀️","🌤️","⛅","🌥️","☁️","🌦️","🌧️","⛈️","🌩️","🌪️",
        "🌫️","🌬️","🌀","💧","💦","☔","☂️","🌊","🌴","🌵","🌾","🌿","☘️","🍀","🍁","🍂","🍃"
    };

    protected override async Task OnInitializedAsync()
    {
        AndroidBackHandler.Register(() => InvokeAsync(GoBack));
        sendOnEnter = bool.Parse(Prefs.Get("send_on_enter", "True"));
        using var scope = ScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ChatDbContext>();
        allContacts = await db.Contacts.AsNoTracking().OrderBy(c => c.DisplayName).ToListAsync();
        contactNames = allContacts.ToDictionary(c => c.Email, c => c.DisplayName ?? c.Email.Split('@')[0], StringComparer.OrdinalIgnoreCase);
        chats = await db.Chats.AsNoTracking().Where(c => !c.Deleted).ToListAsync();
        ChatEvents.ChatUpdated += OnChatUpdated;
        ChatEvents.AccountSwitched += OnAccountSwitched;
    }

    public void Dispose()
    {
        AndroidBackHandler.Unregister();
        ChatEvents.ChatUpdated -= OnChatUpdated;
        ChatEvents.AccountSwitched -= OnAccountSwitched;
    }

    private int _loadGeneration; // incremented on each load to cancel stale concurrent loads

    private void OnChatUpdated(string chatId)
    {
        if (chatId != ChatId) return;
        InvokeAsync(async () =>
        {
            try
            {
                // Check if the chat was deleted
                using var checkScope = ScopeFactory.CreateScope();
                var checkDb = checkScope.ServiceProvider.GetRequiredService<ChatDbContext>();
                var chatStillExists = await checkDb.Chats.AnyAsync(c => c.ChatId == ChatId && !c.Deleted);
                if (!chatStillExists)
                {
                    GoBack();
                    return;
                }
                // Check if user is near the bottom before reloading messages
                _wasNearBottom = await JS.InvokeAsync<bool>("eval",
                    "var el=document.querySelector('.mobile-messages-container');" +
                    "el && el.scrollHeight - el.scrollTop - el.clientHeight < 80;");
                await LoadMessagesAsync();
                await LoadReactionsAsync();
                _scrollToBottom = _wasNearBottom;
                StateHasChanged();
            }
            catch { /* don't crash the component on background update */ }
        });
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(ChatId))
        {
            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ChatDbContext>();
            selectedChat = await db.Chats.AsNoTracking().FirstOrDefaultAsync(c => c.ChatId == ChatId);
            if (selectedChat != null)
            {
                if (selectedChat.Type == ChatType.Group && !string.IsNullOrEmpty(selectedChat.GroupId))
                {
                    memberColors = await db.GroupMembers.AsNoTracking()
                        .Where(m => m.GroupId == selectedChat.GroupId)
                        .Where(m => m.NameColor != null)
                        .ToDictionaryAsync(m => m.MemberEmail, m => m.NameColor!, StringComparer.OrdinalIgnoreCase);
                }
                else
                {
                    memberColors.Clear();
                }
                await LoadMessagesAsync();
                await LoadRecipientsAsync();
                await LoadReactionsAsync();
                await ClearUnreadAsync(ChatId);
                _ = SendReadReceiptsAsync(ChatId);  // fire-and-forget: notify sender their messages were read
                _scrollToBottom = true;
                StateHasChanged();
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("setupTextareaResize");
        }
        if (_scrollToBottom)
        {
            _scrollToBottom = false;
            try
            {
                await Task.Yield();
                await JS.InvokeVoidAsync("eval",
                    "var el=document.querySelector('.mobile-messages-container');" +
                    "if(el)el.scrollTop=el.scrollHeight;");
            }
            catch (Exception ex) 
            { 
                FileLogger.Write("ERROR", "Scroll", $"Scroll failed: {ex.Message}"); 
            }
        }
    }

    private async Task LoadMessagesAsync()
    {
        if (string.IsNullOrEmpty(ChatId)) return;
        var gen = ++_loadGeneration;

        using var scope = ScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ChatDbContext>();

        var list = await db.Messages
            .AsNoTracking()
            .Where(m => m.ChatId == ChatId)
            .ToListAsync();

        if (gen != _loadGeneration) return; // superseded by a newer load

        messages = list.OrderBy(m => m.DisplayTimestamp).ToList();
        messagesById = messages.ToDictionary(m => m.MessageId, StringComparer.OrdinalIgnoreCase);

        var msgIds = messages.Select(m => m.MessageId).ToList();
        var atts = await db.Attachments
            .AsNoTracking()
            .Where(a => msgIds.Contains(a.MessageId))
            .ToListAsync();
        var uniqueAtts = atts
            .GroupBy(a => new { a.MessageId, a.FileName })
            .Select(g => g.First())
            .ToList();
        _messageAttachments = uniqueAtts.GroupBy(a => a.MessageId)
            .ToDictionary(g => g.Key, g => g.ToList(), StringComparer.OrdinalIgnoreCase);
    }

    private async Task LoadRecipientsAsync()
    {
        if (selectedChat == null) return;
        if (selectedChat.Type == ChatType.Group)
        {
            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ChatDbContext>();
            recipients = await db.GroupMembers
                .AsNoTracking()
                .Where(m => m.GroupId == selectedChat.GroupId && m.MemberEmail != UserContext.UserEmail)
                .Select(m => m.MemberEmail)
                .ToListAsync();
        }
        else
        {
            recipients = await GetRecipientsForChatAsync(selectedChat);
        }
    }

    private async Task LoadReactionsAsync()
    {
        if (string.IsNullOrEmpty(ChatId)) return;
        var msgIds = messages?.Select(m => m.MessageId).ToList();
        if (msgIds == null || msgIds.Count == 0) return;

        using var scope = ScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ChatDbContext>();
        var reacts = await db.MessageReactions
            .AsNoTracking()
            .Where(r => msgIds.Contains(r.MessageId))
            .ToListAsync();

        _messageReactions = reacts.GroupBy(r => r.MessageId)
            .ToDictionary(g => g.Key, g => g.ToList(), StringComparer.OrdinalIgnoreCase);
    }

    private async Task ClearUnreadAsync(string chatId)
    {
        await DbContext.Messages
            .Where(m => m.ChatId == chatId && m.Sender != UserContext.UserEmail)
            .ExecuteUpdateAsync(s => s.SetProperty(m => m.Status, MessageStatus.Read));
        await DbContext.Chats
            .Where(c => c.ChatId == chatId)
            .ExecuteUpdateAsync(s => s.SetProperty(c => c.UnreadCount, 0));
    }

    private async Task SendReadReceiptsAsync(string chatId)
    {
        // Read receipts are only sent for 1-to-1 chats (not groups)
        if (selectedChat?.Type == ChatType.Group) return;
        var myEmail = UserContext.UserEmail;
        if (string.IsNullOrEmpty(myEmail)) return;

        var allReceived = await DbContext.Messages
            .AsNoTracking()
            .Where(m => m.ChatId == chatId && m.Sender != myEmail)
            .Select(m => new { m.MessageId, m.Sender })
            .ToListAsync();

        var receivedIds = allReceived
            .Where(m => !_sentReceiptIds.Contains(m.MessageId))
            .ToList();

        if (receivedIds.Count == 0) return;

        foreach (var m in receivedIds)
            _sentReceiptIds.Add(m.MessageId);

        foreach (var grp in receivedIds.GroupBy(m => m.Sender))
        {
            try
            {
                var contact = await DbContext.Contacts.FindAsync(grp.Key);
                await TransportService.SendMessageAsync(new OutgoingMessage
                {
                    MessageId = Guid.NewGuid().ToString(),
                    Content = "read-notification",
                    Recipients = new List<string> { grp.Key },
                    RecipientPublicKey = contact?.PublicKey,
                    Timestamp = DateTimeOffset.UtcNow,
                    Type = MessageType.ReadReceipt,
                    ReadOf = grp.Select(m => m.MessageId).ToList(),
                    Tier = BatchTier.System,
                    Encrypt = !string.IsNullOrEmpty(contact?.PublicKey)
                });
            }
            catch { }
        }
    }

    private async Task SendMessage()
    {
        var domText = await JS.InvokeAsync<string>("getMessageInputValue");
        messageText = domText;
        if ((string.IsNullOrWhiteSpace(messageText) && pendingAttachments.Count == 0) || selectedChat == null) return;
        var text = messageText.Trim();
        messageText = string.Empty;
        await JS.InvokeVoidAsync("clearMessageInput");

        if (editingMessage != null)
        {
            var editing = editingMessage;
            editingMessage = null;
            await DbContext.Messages
                .Where(m => m.MessageId == editing.MessageId)
                .ExecuteUpdateAsync(s => s
                    .SetProperty(m => m.Content, text)
                    .SetProperty(m => m.IsEdited, true)
                    .SetProperty(m => m.EditVersion, editing.EditVersion + 1));
            await LoadMessagesAsync();
            _scrollToBottom = true;
            if (recipients != null && recipients.Any())
            {
                await TransportService.SendMessageAsync(new OutgoingMessage
                {
                    MessageId = Guid.NewGuid().ToString(),
                    Content = text,
                    Recipients = recipients,
                    GroupId = selectedChat.GroupId,
                    Timestamp = DateTimeOffset.UtcNow,
                    Type = MessageType.Edit,
                    EditOf = editing.MessageId,
                    EditVersion = editing.EditVersion + 1,
                    Tier = BatchTier.Immediate,
                    Subject = "[eChat]"
                });
            }
            return;
        }

        if (recipients == null || !recipients.Any())
        {
            sendError = "Cannot determine recipient.";
            return;
        }
        sendError = string.Empty;

        var msgId = Guid.NewGuid().ToString();
        var now = DateTimeOffset.UtcNow;
        var replyTo = replyingToMessage;
        replyingToMessage = null;

        var newMsg = new ChatMessage
        {
            MessageId = msgId,
            ChatId = ChatId,
            Sender = UserContext.UserEmail,
            Content = text,
            Timestamp = now,
            DisplayTimestamp = now,
            ReceivedAt = now,
            InReplyTo = replyTo?.MessageId,
            Status = MessageStatus.Sending
        };

        var attachmentsToSend = new List<AttachmentInfo>();
        var newAttachments = new List<Attachment>();
        foreach (var att in pendingAttachments)
        {
            var attFileName = $"{msgId}_{att.FileName}";
            var attPath = Path.Combine(DbPathInfo.AttachmentsDir, attFileName);
            Directory.CreateDirectory(DbPathInfo.AttachmentsDir);
            await File.WriteAllBytesAsync(attPath, att.Data);

            var dbAtt = new Attachment
            {
                Id = Guid.NewGuid().ToString(),
                MessageId = msgId,
                FileName = att.FileName,
                ContentType = att.ContentType,
                Size = att.Size,
                FilePath = attFileName,
                Caption = att.Caption,
            };
            newAttachments.Add(dbAtt);
            DbContext.Attachments.Add(dbAtt);

            attachmentsToSend.Add(new AttachmentInfo
            {
                FileName = att.FileName,
                ContentType = att.ContentType,
                Size = att.Size,
                Data = att.Data
            });
        }
        pendingAttachments.Clear();

        // Optimistic UI: show message immediately
        messages ??= new List<ChatMessage>();
        messages.Add(newMsg);
        messagesById[msgId] = newMsg;
        if (newAttachments.Count > 0)
            _messageAttachments[msgId] = newAttachments;
        if (selectedChat != null) selectedChat.LastActivityAt = now;
        _scrollToBottom = true;
        StateHasChanged();

        // Persist to DB
        DbContext.Messages.Add(newMsg);
        var trackedChat = await DbContext.Chats.FindAsync(ChatId);
        if (trackedChat != null) trackedChat.LastActivityAt = now;
        await DbContext.SaveChangesAsync();

        // Send via SMTP in background
        var outgoing = new OutgoingMessage
        {
            MessageId = msgId,
            Content = text,
            Recipients = recipients,
            GroupId = selectedChat.GroupId,
            Timestamp = now,
            InReplyTo = replyTo?.MessageId,
            Tier = BatchTier.Immediate,
            Subject = "[eChat]",
            Attachments = attachmentsToSend.Count > 0 ? attachmentsToSend : null
        };
        _ = TransportService.SendMessageAsync(outgoing).ContinueWith(async t =>
        {
            var newStatus = t.IsCompletedSuccessfully ? MessageStatus.Sent : MessageStatus.Sending;
            try
            {
                await DbContext.Messages
                    .Where(m => m.MessageId == msgId)
                    .ExecuteUpdateAsync(s => s.SetProperty(m => m.Status, newStatus));
            }
            catch { /* ignore */ }
            await InvokeAsync(() =>
            {
                var msg = messages?.FirstOrDefault(m => m.MessageId == msgId);
                if (msg != null) { msg.Status = newStatus; StateHasChanged(); }
            });
        });
    }

    private async Task HandleReaction((string Emoji, ChatMessage Message) data)
    {
        if (string.IsNullOrEmpty(data.Emoji)) return;

        var msgId = data.Message.MessageId;
        if (!_messageReactions.TryGetValue(msgId, out var reactionList))
        {
            reactionList = new List<MessageReaction>();
            _messageReactions[msgId] = reactionList;
        }

        var existing = reactionList.FirstOrDefault(r => r.Emoji == data.Emoji && r.Sender == UserContext.UserEmail);

        OutgoingMessage? outgoing = null;
        if (existing != null)
        {
            reactionList.Remove(existing);
            DbContext.MessageReactions.Remove(existing);
        }
        else
        {
            var reaction = new MessageReaction
            {
                MessageId = msgId,
                Emoji = data.Emoji,
                Sender = UserContext.UserEmail,
                Timestamp = DateTimeOffset.UtcNow
            };
            reactionList.Add(reaction);
            DbContext.MessageReactions.Add(reaction);

            if (recipients != null && recipients.Any())
            {
                outgoing = new OutgoingMessage
                {
                    MessageId = Guid.NewGuid().ToString(),
                    Content = data.Emoji,
                    Recipients = recipients,
                    GroupId = selectedChat?.GroupId,
                    Timestamp = DateTimeOffset.UtcNow,
                    Type = MessageType.Reaction,
                    Reaction = data.Emoji,
                    ReactionTo = msgId,
                    Tier = BatchTier.Immediate
                };
            }
        }

        // Show immediately
        StateHasChanged();

        // Persist (fast)
        await DbContext.SaveChangesAsync();

        // Send in background
        if (outgoing != null)
            _ = TransportService.SendMessageAsync(outgoing)
                .ContinueWith(t => FileLogger.Write("WARN", "HandleReaction",
                    $"Send reaction failed: {t.Exception?.GetBaseException().Message}"),
                    TaskContinuationOptions.OnlyOnFaulted);
    }

