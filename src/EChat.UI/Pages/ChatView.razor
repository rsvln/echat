    private async Task ForwardToChat(Chat targetChat)
    {
        if (forwardingMessage == null) return;
        showForwardDialog = false;

        var targetRecipients = await GetRecipientsForChatAsync(targetChat);
        if (targetRecipients == null || !targetRecipients.Any()) return;

        var attachments = DbContext.Attachments
            .Where(a => a.MessageId == forwardingMessage.MessageId)
            .ToList()
            .Select(a => new AttachmentInfo
            {
                FileName = a.FileName,
                ContentType = a.ContentType,
                Size = a.Size,
                Data = System.IO.File.Exists(DbPathInfo.ResolveFilePath(a.FilePath)) ? System.IO.File.ReadAllBytes(DbPathInfo.ResolveFilePath(a.FilePath)) : Array.Empty<byte>()
            })
            .ToList();

        await TransportService.SendMessageAsync(new OutgoingMessage
        {
            MessageId = Guid.NewGuid().ToString(),
            Content = forwardingMessage.Content,
            Recipients = targetRecipients,
            GroupId = targetChat.GroupId,
            Timestamp = DateTimeOffset.UtcNow,
            Tier = BatchTier.Immediate,
            Subject = "[eChat]",
            Attachments = attachments.Count > 0 ? attachments : null
        });
        forwardingMessage = null;
    }

