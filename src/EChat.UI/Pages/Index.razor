@page "/"
@using EChat.Core.Data
@using EChat.Core.Services
@using Microsoft.EntityFrameworkCore
@inject ChatDbContext DbContext
@inject NavigationManager Navigation
@inject AppStartupService Startup

@code {
    protected override async Task OnInitializedAsync()
    {
        // Wait for migrations to complete (signalled by InitializeEChatDatabaseAsync).
        // Timeout 15 s as a safety net — on failure fall through to /setup.
        await Startup.MigrationsReady.WaitAsync(TimeSpan.FromSeconds(15));

        try
        {
            var hasAccount = await DbContext.Accounts.AnyAsync();
            Navigation.NavigateTo(hasAccount ? "/chats" : "/setup", replace: true);
        }
        catch
        {
            Navigation.NavigateTo("/setup", replace: true);
        }
    }
}
