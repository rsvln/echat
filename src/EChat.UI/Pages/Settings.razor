    /// <summary>
    /// Formats an exception into a user-visible error string with enough detail to diagnose issues.
    /// Shows exception type + message + inner exception chain so "Export failed: " never appears blank.
    /// </summary>
    private static string FormatError(string prefix, Exception ex)
    {
        var parts = new System.Text.StringBuilder();
        parts.Append(prefix).Append(": ");

        var e = ex;
        var depth = 0;
        while (e != null && depth < 4)
        {
            if (depth > 0) parts.Append(" → ");
            var msg = e.Message;
            if (string.IsNullOrWhiteSpace(msg))
                msg = e.GetType().Name;
            else
                msg = $"{e.GetType().Name}: {msg}";
            parts.Append(msg);
            e = e.InnerException;
            depth++;
        }

        return parts.ToString();
    }
