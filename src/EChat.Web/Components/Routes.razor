@using Microsoft.AspNetCore.Components.Routing
@using EChat.UI.Pages

<Router AppAssembly="typeof(EChat.UI.Pages.Index).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" />
    </Found>
    <NotFound>
        <p>Page not found</p>
    </NotFound>
</Router>

@* Headless bridge — forwards incoming-message events to the browser Notifications API *@
<NotificationBridge />
